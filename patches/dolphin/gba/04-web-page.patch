+struct Slot
+{
+  bool active = false;
+  u16 width = 240;
+  u16 height = 160;
+  u32 seq = 0;
+  std::vector<u16> pixels;
+  // The newest packed picture made of it, for the browsers.
+  std::vector<u8> packed;
+  u32 packed_seq = 0;
+};
+
+struct Client
+{
+  std::thread thread;
+  std::atomic<bool> done{false};
+};
+
+struct PortState
+{
+  std::atomic<int> viewers{0};  // open /video sockets
+  std::atomic<bool> republish{false};  // a page just came: send it the picture again, fresh
+  std::atomic<u64> key_owner{0};
+};
+
+struct State
+{
+  std::mutex lifecycle;  // hosts coming and going, the server's start / stop
+  std::mutex m;          // the slots
+  std::condition_variable raw_ready, packed_ready;
+  Slot slots[MAX_DEVICES];
+  PortState ports[MAX_DEVICES];
+  int refs = 0;
+  bool server_wanted = true;  // dolphin_gba_set_web_server: off, the GBA runs with no page
+  std::atomic<long long> last_view_ms{0};  // the latest dolphin_gba_get_frame
+  std::atomic<bool> stop{false};
+  std::atomic<u64> next_id{1};
+  int listener = -1;
+  std::thread accept_thread, encode_thread;
+  std::list<Client> clients;  // the accept thread's, and StopServer's once that has been joined
+  // Counted for the five-second Debug line while someone watches.
+  std::atomic<unsigned> converted{0}, encoded{0}, sent{0};
+  std::atomic<unsigned long long> bytes{0};
+};
