+// ---- the sockets -------------------------------------------------------------------------------
+
+void Reply(int fd, int code, const char* reason, const char* type, const std::string& body)
+{
+  char head[256];
+  const int n = std::snprintf(head, sizeof head,
+                              "HTTP/1.1 %d %s\r\nContent-Type: %s\r\nContent-Length: %zu\r\n"
+                              "Cache-Control: no-store\r\nConnection: close\r\n\r\n",
+                              code, reason, type, body.size());
+  ps5stream::SendBytes(fd, head, static_cast<std::size_t>(n), Alive);
+  ps5stream::SendBytes(fd, body.data(), body.size(), Alive);
+}
+
+// Pictures as they come, up to AHEAD before the page's "ack"s; "fps N" (60, 30, 20, 15) spaces
+// them. A slow page gets the newest when there's room, never a queue.
+void Video(ps5stream::WebSocket& socket, int port)
+{
+  State& s = S();
+  PortState& ps = s.ports[port];
+  ++ps.viewers;
+  ps.republish.store(true);
+  s.raw_ready.notify_all();  // a picture kept from before can be packed for this one now
+  DEBUG_LOG_FMT(SERIALINTERFACE, "GBA web: a browser is watching GBA {}", port + 1);
+  int ahead = 0, fps = 60;
+  u32 sent_seq = 0;
+  long long last_sent = 0;
+  std::vector<u8> picture;
+  std::string message;
+  for (;;)
+  {
+    const auto r = socket.Receive(message, ahead >= AHEAD ? 20 : 1);
+    if (r == ps5stream::WebSocket::Result::Closed || r == ps5stream::WebSocket::Result::Error)
+      break;
+    if (r == ps5stream::WebSocket::Result::Text)
+    {
+      if (message == "ack")
+        ahead = std::max(0, ahead - 1);
+      else if (message.rfind("fps ", 0) == 0)
+        fps = std::clamp(std::atoi(message.c_str() + 4), 1, 60);
+      continue;
+    }
+    if (ahead >= AHEAD)
+      continue;
+    const long long gap = 1000 / fps - 2;  // a little early rather than a frame late
+    if (NowMs() - last_sent < gap)
+      continue;
+    {
+      std::unique_lock lock(s.m);
+      const Slot& slot = s.slots[port];
+      s.packed_ready.wait_for(lock, std::chrono::milliseconds(15), [&] {
+        return s.stop.load() || (slot.packed_seq != sent_seq && !slot.packed.empty());
+      });
+      if (s.stop.load())
+        break;
+      if (slot.packed_seq == sent_seq || slot.packed.empty())
+        continue;
+      picture = slot.packed;
+      sent_seq = slot.packed_seq;
+    }
+    if (!socket.Send(2, picture.data(), picture.size()))
+      break;
+    last_sent = NowMs();
+    ++ahead;
+    ++s.sent;
+    s.bytes += picture.size();
+  }
+  --ps.viewers;
+  DEBUG_LOG_FMT(SERIALINTERFACE, "GBA web: a browser stopped watching GBA {}", port + 1);
+}
+
+// "k <mask>": the buttons held, sent on each change and every quarter second while any is;
+// "reset": the page's Reset GBA.
+void Input(ps5stream::WebSocket& socket, int port)
+{
+  State& s = S();
+  PortState& ps = s.ports[port];
+  const u64 me = s.next_id++;
+  long long keys_ms = 0;
+  std::string message;
+  for (;;)
+  {
+    const auto r = socket.Receive(message, 200);
+    if (r == ps5stream::WebSocket::Result::Closed || r == ps5stream::WebSocket::Result::Error)
+      break;
+    // A held button the page stopped refreshing (a lost network) must not stay held.
+    if (keys_ms && NowMs() - keys_ms > KEY_QUIET_MS && ps.key_owner.load() == me)
+    {
+      HW::GBA::ExternalKeys(port).store(0);
+      keys_ms = 0;
+    }
+    if (r != ps5stream::WebSocket::Result::Text)
+      continue;
+    if (message == "reset")
+    {
+      HW::GBA::ResetRequest(port).store(true);
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: Reset from the page", port + 1);
+    }
+    else if (message.rfind("k ", 0) == 0)
+    {
+      const long mask = std::strtol(message.c_str() + 2, nullptr, 10);
+      HW::GBA::ExternalKeys(port).store(static_cast<u16>(mask & 0x3FF));
+      ps.key_owner.store(me);
+      keys_ms = NowMs();
+    }
+  }
+  if (ps.key_owner.load() == me)
+    HW::GBA::ExternalKeys(port).store(0);
+}
+
+unsigned ActivePorts()
+{
+  State& s = S();
+  std::lock_guard lock(s.m);
+  unsigned ports = 0;
+  for (int i = 0; i < MAX_DEVICES; ++i)
+  {
+    if (s.slots[i].active)
+      ports |= 1u << i;
+  }
+  return ports;
+}
+
+void Handle(int fd, Client* client)
+{
+  ps5stream::ConfigureSocket(fd);
+  std::string request;
+  const long long until = NowMs() + 5000;
+  while (request.find("\r\n\r\n") == std::string::npos && request.size() < 8192 &&
+         NowMs() < until && Alive())
+  {
+    pollfd p{fd, POLLIN, 0};
+    if (poll(&p, 1, 50) <= 0)
+      continue;
+    char buf[1024];
+    const auto n = recv(fd, buf, sizeof buf, 0);
+    if (n <= 0)
+      break;
+    request.append(buf, static_cast<std::size_t>(n));
+  }
+  const std::size_t sp1 = request.find(' ');
+  const std::size_t sp2 = sp1 == std::string::npos ? sp1 : request.find(' ', sp1 + 1);
+  std::string path = sp2 == std::string::npos ? "" : request.substr(sp1 + 1, sp2 - sp1 - 1);
+  const std::size_t q = path.find('?');
+  const std::string query = q == std::string::npos ? "" : path.substr(q + 1);
+  path = path.substr(0, q);
+  // ?p=1..4: which port's GBA; otherwise the lowest with one.
+  int port = -1;
+  const std::size_t pp = query.find("p=");
+  if (pp != std::string::npos && (pp == 0 || query[pp - 1] == '&'))
+    port = std::atoi(query.c_str() + pp + 2) - 1;
+  const unsigned ports = ActivePorts();
+  if (port < 0 || port >= MAX_DEVICES || !(ports & (1u << port)))
+  {
+    port = 0;
+    for (int i = 0; i < MAX_DEVICES; ++i)
+    {
+      if (ports & (1u << i))
+      {
+        port = i;
+        break;
+      }
+    }
+  }
+  if (request.rfind("GET ", 0) != 0)
+  {
+    Reply(fd, request.empty() ? 408 : 405, request.empty() ? "Request Timeout" : "Method Not Allowed",
+          "text/plain", "GET only\n");
+  }
+  else if (path == "/" || path == "/index.html")
+  {
+    Reply(fd, 200, "OK", "text/html; charset=utf-8", PAGE);
+  }
+  else if (path == "/multi")
+  {
+    Reply(fd, 200, "OK", "text/html; charset=utf-8", MULTI_PAGE);
+  }
+  else if (path == "/ports")
+  {
+    // The ports with a GBA, as a JSON list of 1..4.
+    std::string list = "[";
+    for (int i = 0; i < MAX_DEVICES; ++i)
+    {
+      if (ports & (1u << i))
+        list += (list.size() > 1 ? "," : "") + std::to_string(i + 1);
+    }
+    Reply(fd, 200, "OK", "application/json", list + "]");
+  }
+  else if (path == "/video" || path == "/input")
+  {
+    ps5stream::WebSocket socket(fd, Alive);
+    if (!socket.Upgrade(request))
+      Reply(fd, 400, "Bad Request", "text/plain", "a WebSocket is expected here\n");
+    else if (path == "/video")
+      Video(socket, port);
+    else
+      Input(socket, port);
+  }
+  else
+  {
+    Reply(fd, 404, "Not Found", "text/plain", "not here\n");
+  }
+  close(fd);
+  client->done = true;
+}
+
+void AcceptLoop()
+{
+  State& s = S();
+  long long last_report = NowMs();
+  unsigned rep_conv = 0, rep_enc = 0, rep_sent = 0;
+  unsigned long long rep_bytes = 0;
+  while (Alive())
+  {
+    pollfd p{s.listener, POLLIN, 0};
+    if (poll(&p, 1, 100) > 0)
+    {
+      const int fd = accept(s.listener, nullptr, nullptr);
+      if (fd >= 0)
+      {
+        if (s.clients.size() >= MAX_CLIENTS)
+        {
+          WARN_LOG_FMT(SERIALINTERFACE, "GBA web: a browser turned away ({} connections open)",
+                       s.clients.size());
+          close(fd);
+        }
+        else
+        {
+          s.clients.emplace_back();
+          Client* c = &s.clients.back();
+          c->thread = std::thread(Handle, fd, c);
+        }
+      }
+    }
+    for (auto it = s.clients.begin(); it != s.clients.end();)
+    {
+      if (it->done.load())
+      {
+        it->thread.join();
+        it = s.clients.erase(it);
+      }
+      else
+      {
+        ++it;
+      }
+    }
+    if (NowMs() - last_report >= 5000)
+    {
+      last_report = NowMs();
+      const unsigned conv = s.converted.load(), enc = s.encoded.load(), snt = s.sent.load();
+      const unsigned long long b = s.bytes.load();
+      if (snt != rep_sent)
+      {
+        DEBUG_LOG_FMT(SERIALINTERFACE,
+                      "GBA web: last 5 s: {} new pictures, {} packed, {} sent, {} KiB ({} browsers)",
+                      conv - rep_conv, enc - rep_enc, snt - rep_sent, (b - rep_bytes) / 1024,
+                      Viewers());
+      }
+      rep_conv = conv, rep_enc = enc, rep_sent = snt, rep_bytes = b;
+    }
+  }
+}
+
+void StartServer(State& s)  // with s.lifecycle held
+{
+  if (s.accept_thread.joinable())
+    return;
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA web: no socket (errno {})", errno);
+    return;
+  }
+  int yes = 1;
+  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof yes);
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(PORT);
+  addr.sin_addr.s_addr = htonl(INADDR_ANY);
+  if (bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof addr) != 0 || listen(fd, 8) != 0)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA web: cannot listen on port {} (errno {})", PORT, errno);
+    close(fd);
+    return;
+  }
+  fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+  s.stop = false;
+  s.listener = fd;
+  s.accept_thread = std::thread(AcceptLoop);
+  s.encode_thread = std::thread(EncodeLoop);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA web: serving on port {}", PORT);
+}
+
+void StopServer(State& s)  // with s.lifecycle held
+{
+  if (!s.accept_thread.joinable())
+    return;
+  s.stop = true;
+  s.raw_ready.notify_all();
+  s.packed_ready.notify_all();
+  s.accept_thread.join();
+  s.encode_thread.join();
+  for (Client& c : s.clients)
+    c.thread.join();
+  s.clients.clear();
+  close(s.listener);
+  s.listener = -1;
+  s.stop = false;
+  for (int i = 0; i < MAX_DEVICES; ++i)
+    HW::GBA::ExternalKeys(i).store(0);
+  {
+    std::lock_guard lock(s.m);
+    for (Slot& slot : s.slots)
+    {
+      slot.packed.clear();
+      slot.packed_seq = 0;
+    }
+  }
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA web: stopped");
+}
+
+class WebHost final : public GBAHostInterface
+{
+public:
+  explicit WebHost(int device) : m_device(device)
+  {
+    State& s = S();
+    std::lock_guard life(s.lifecycle);
+    {
+      std::lock_guard lock(s.m);
+      s.slots[m_device] = Slot{};
+      s.slots[m_device].active = true;
+    }
+    ++s.refs;
+    if (s.server_wanted)
+      StartServer(s);
+  }
+
+  ~WebHost() override
+  {
+    State& s = S();
+    std::lock_guard life(s.lifecycle);
+    HW::GBA::ExternalKeys(m_device).store(0);
+    HW::GBA::FrontendKeys(m_device).store(0);
+    {
+      std::lock_guard lock(s.m);
+      s.slots[m_device].active = false;
+    }
+    if (--s.refs <= 0)
+    {
+      s.refs = 0;
+      StopServer(s);
+    }
+  }
+
+  void GameChanged() override {}
+
+  // Called on the GBA's own thread, once per finished frame.
+  void FrameEnded(std::span<const u32> video) override
+  {
+    State& s = S();
+    const long long now = NowMs();
+    if (video.empty() ||
+        (s.ports[m_device].viewers.load(std::memory_order_relaxed) == 0 &&
+         now - s.last_view_ms.load(std::memory_order_relaxed) > VIEWER_GRACE_MS))
+      return;
+    // The first frame after a pause (nobody watching) is published even if it equals the last
+    // one kept: that one may be from long ago, and a still screen would never send another.
+    // So is the first after a page connects (switching between / and /multi): it gets a fresh
+    // copy of a still screen, whatever it did with the kept one.
+    // (Both are asked: the flag is taken either way.)
+    const bool asked = s.ports[m_device].republish.exchange(false, std::memory_order_relaxed);
+    const bool resumed = now - m_last_converted_ms > 250 || asked;
+    m_last_converted_ms = now;
+
+    u16 width = 240;
+    u16 height = static_cast<u16>(std::min<std::size_t>(video.size() / 240, 0xFFFF));
+    if (video.size() == 160 * 144)
+    {
+      width = 160;
+      height = 144;
+    }
+
+    // Converted outside the lock. mGBA's pixels are 0x00BBGGRR with each channel's top five bits
+    // significant.
+    m_scratch.resize(std::size_t{width} * height);
+    const std::size_t n = std::min(m_scratch.size(), video.size());
+    for (std::size_t i = 0; i < n; ++i)
+    {
+      const u32 v = video[i];
+      m_scratch[i] = static_cast<u16>(((v >> 3) & 0x1F) | (((v >> 11) & 0x1F) << 5) |
+                                      (((v >> 19) & 0x1F) << 10));
+    }
+
+    {
+      std::lock_guard lock(s.m);
+      Slot& slot = s.slots[m_device];
+      // A picture that has not changed is not a new frame: still screens (most of the Tingle
+      // Tuner's) then cost the browser nothing.
+      if (!resumed && slot.width == width && slot.height == height && slot.pixels == m_scratch)
+        return;
+      slot.width = width;
+      slot.height = height;
+      slot.pixels.swap(m_scratch);
+      if (++slot.seq == 0)
+        slot.seq = 1;  // 0 is "nothing yet"
+    }
+    ++s.converted;
+    s.raw_ready.notify_one();
+  }
+
+private:
+  const int m_device;
+  std::vector<u16> m_scratch;         // the GBA thread's own
+  long long m_last_converted_ms = 0;  // the GBA thread's own
+};
+}  // namespace
+
+std::unique_ptr<GBAHostInterface> CreateHost(std::weak_ptr<HW::GBA::Core> core)
+{
+  const auto locked = core.lock();
+  if (!locked)
+    return nullptr;
+  const int device = locked->GetCoreInfo().device_number;
+  if (device < 0 || device >= MAX_DEVICES)  // the Game Boy Player's GBA has no screen to show
+    return nullptr;
+  return std::make_unique<WebHost>(device);
+}
+}  // namespace Libretro::GBAWeb
+
+// ---- For a frontend that knows this core ------------------------------------------------------
+// Looked up by name (dlsym); a frontend that does not know them is unaffected.
+// The buttons the frontend holds on the GBA in SI port `port` (0-3), as mGBA's key mask (A, B,
+// Select, Start, Right, Left, Up, Down, R, L = bits 0..9). Kept until the next call, OR-ed with
+// the page's. Call it once per frame, before retro_run.
+extern "C" __attribute__((visibility("default"))) void dolphin_gba_set_keys(unsigned port,
+                                                                            uint16_t mask)
+{
+  HW::GBA::FrontendOwnsInput().store(true, std::memory_order_relaxed);
+  if (port < Libretro::GBAWeb::MAX_DEVICES)
+    HW::GBA::FrontendKeys(static_cast<int>(port)).store(mask & 0x3FF);
+}
+
+// The GBA in SI port `port` (0-3) starts over, as Dolphin's own Reset does; the GameCube game goes
+// on. Taken at the GBA's next poll, on the CPU thread.
+extern "C" __attribute__((visibility("default"))) void dolphin_gba_reset(unsigned port)
+{
+  if (port < Libretro::GBAWeb::MAX_DEVICES)
+  {
+    HW::GBA::ResetRequest(static_cast<int>(port)).store(true);
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: reset asked for", port + 1);
+  }
+}
+
+// Asks the GBA in SI port `port` (0-3) to do what Dolphin's GBA window can (HW::GBA::Request:
+// 0 Connect, 1 Disconnect, 2 LoadRom, 3 LoadRomSavesHere, 4 ImportState, 5 ExportState,
+// 6 ImportSave, 7 ExportSave, 8 EReaderCard), with a file's path where it takes one. Done at the
+// GBA's next poll, on the CPU thread.
+extern "C" __attribute__((visibility("default"))) void dolphin_gba_request(unsigned port, int what,
+                                                                           const char* path)
+{
+  if (port >= Libretro::GBAWeb::MAX_DEVICES || what < 0 ||
+      what > static_cast<int>(HW::GBA::Request::EReaderCard))
+    return;
+  auto& requests = HW::GBA::RequestsFor(static_cast<int>(port));
+  std::lock_guard lock(requests.lock);
+  requests.queue.emplace_back(static_cast<HW::GBA::Request>(what), path ? path : "");
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: request {} {}", port + 1, what, path ? path : "");
+}
+
+// The page on port 6771: on (the default) or off, for a frontend with its own (or none). Takes
+// effect at once: off stops the server and drops its browsers; the GBA runs on.
+extern "C" __attribute__((visibility("default"))) void dolphin_gba_set_web_server(bool on)
+{
+  using namespace Libretro::GBAWeb;
+  State& s = S();
+  std::lock_guard life(s.lifecycle);
+  if (s.server_wanted == on)
+    return;
+  s.server_wanted = on;
+  if (on && s.refs > 0)
+    StartServer(s);
+  else if (!on)
+    StopServer(s);
+}
+
+// Copies the newest frame of the GBA in SI port `port` (0-3) when it is newer than *seq. Returns
+// false (nothing written) when the port holds no GBA or nothing is new. `pixels` takes
+// width*height u16 (at most 240*160; `capacity` is its size in pixels), the GBA's 15-bit colour:
+// bits 0-4 red, 5-9 green, 10-14 blue. Asking is what keeps the frames coming: the GBA thread
+// converts them only while someone asked in the last three seconds (or a browser watches).
+extern "C" __attribute__((visibility("default"))) bool
+dolphin_gba_get_frame(unsigned port, uint16_t* pixels, size_t capacity, unsigned* width,
+                      unsigned* height, unsigned* seq)
+{
+  using namespace Libretro::GBAWeb;
+  if (port >= MAX_DEVICES || !pixels || !width || !height || !seq)
+    return false;
+  State& s = S();
+  s.last_view_ms.store(NowMs(), std::memory_order_relaxed);
+  std::lock_guard lock(s.m);
+  const Slot& slot = s.slots[port];
+  if (!slot.active || slot.seq == *seq || slot.pixels.empty() || slot.pixels.size() > capacity)
+    return false;
+  std::copy(slot.pixels.begin(), slot.pixels.end(), pixels);
+  *width = slot.width;
+  *height = slot.height;
+  *seq = slot.seq;
+  return true;
+}
+
+#endif  // _WIN32
+
+#endif  // HAS_LIBMGBA
