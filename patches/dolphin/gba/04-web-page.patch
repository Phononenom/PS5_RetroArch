+// ---- the pictures, packed ----------------------------------------------------------------------
+
+// Each pixel XOR the one above, then PackBits-style 16-bit symbols: a control byte below 128 is
+// that many plus one literals that follow, 128 and up a run of (byte - 125) copies of the one that
+// follows. A message is 'G' 'B' 'A' '2', width and height (u16 LE), the packed length (u32 LE),
+// the data.
+void Pack(const std::vector<u16>& px, unsigned width, unsigned height, std::vector<u8>& out)
+{
+  const std::size_t n = px.size();
+  std::vector<u16> d(n);
+  for (std::size_t i = 0; i < n; ++i)
+    d[i] = i < width ? px[i] : static_cast<u16>(px[i] ^ px[i - width]);
+  out.assign(12, 0);
+  out.reserve(n / 2 + 16);
+  const auto put16 = [&out](u16 v) {
+    out.push_back(static_cast<u8>(v & 0xFF));
+    out.push_back(static_cast<u8>(v >> 8));
+  };
+  std::size_t i = 0;
+  while (i < n)
+  {
+    std::size_t run = 1;
+    while (i + run < n && d[i + run] == d[i] && run < 130)
+      ++run;
+    if (run >= 3)
+    {
+      out.push_back(static_cast<u8>(0x80 | (run - 3)));
+      put16(d[i]);
+      i += run;
+      continue;
+    }
+    const std::size_t start = i;
+    std::size_t count = 0;
+    while (i < n && count < 128)
+    {
+      std::size_t r = 1;
+      while (i + r < n && d[i + r] == d[i] && r < 3)
+        ++r;
+      if (r >= 3)
+        break;
+      ++i;
+      ++count;
+    }
+    out.push_back(static_cast<u8>(count - 1));
+    for (std::size_t k = 0; k < count; ++k)
+      put16(d[start + k]);
+  }
+  const u32 len = static_cast<u32>(out.size() - 12);
+  const u8 head[12] = {'G',
+                       'B',
+                       'A',
+                       '2',
+                       static_cast<u8>(width),
+                       static_cast<u8>(width >> 8),
+                       static_cast<u8>(height),
+                       static_cast<u8>(height >> 8),
+                       static_cast<u8>(len),
+                       static_cast<u8>(len >> 8),
+                       static_cast<u8>(len >> 16),
+                       static_cast<u8>(len >> 24)};
+  std::copy(head, head + 12, out.begin());
+}
+
+// Packs each GBA's newest picture once, for every browser that shows it.
+void EncodeLoop()
+{
+  State& s = S();
+  std::vector<u16> px;
+  std::vector<u8> out;
+  while (Alive())
+  {
+    int which = -1;
+    unsigned w = 0, h = 0;
+    u32 seq = 0;
+    {
+      std::unique_lock lock(s.m);
+      const auto pending = [&] {
+        for (int p = 0; p < MAX_DEVICES; ++p)
+        {
+          if (s.slots[p].seq != s.slots[p].packed_seq &&
+              s.ports[p].viewers.load(std::memory_order_relaxed) > 0 && !s.slots[p].pixels.empty())
+            return p;
+        }
+        return -1;
+      };
+      s.raw_ready.wait_for(lock, std::chrono::milliseconds(100),
+                           [&] { return s.stop.load() || pending() >= 0; });
+      if (s.stop.load())
+        return;
+      which = pending();
+      if (which < 0)
+        continue;
+      const Slot& slot = s.slots[which];
+      px = slot.pixels;
+      w = slot.width;
+      h = slot.height;
+      seq = slot.seq;
+    }
+    Pack(px, w, h, out);
+    {
+      std::lock_guard lock(s.m);
+      s.slots[which].packed.swap(out);
+      s.slots[which].packed_seq = seq;
+    }
+    ++s.encoded;
+    s.packed_ready.notify_all();
+  }
+}
