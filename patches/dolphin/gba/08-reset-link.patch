diff --git a/Source/Core/DolphinLibretro/GBALink.cpp b/Source/Core/DolphinLibretro/GBALink.cpp
new file mode 100644
index 0000000..1818401
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBALink.cpp
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinLibretro/GBALink.h"
+
+#include <fmt/format.h>
+#include <mutex>
+#include <string>
+
+#include "Common/Logging/Log.h"
+#include "Core/HW/GBAExternalKeys.h"
+#include "VideoCommon/OnScreenDisplay.h"
+
+#ifdef HAS_LIBMGBA
+
+namespace Libretro::GBALink
+{
+void ToggleLinkCable(int port)
+{
+  const bool out = !HW::GBA::LinkPulled(port).load();
+  HW::GBA::LinkPulled(port).store(out);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: link cable {}", port + 1, out ? "out" : "in");
+  OSD::AddMessage(fmt::format("GBA {}: link cable {}", port + 1, out ? "out" : "in"),
+                  OSD::Duration::SHORT);
+  auto& requests = HW::GBA::RequestsFor(port);
+  std::lock_guard lock(requests.lock);
+  requests.queue.emplace_back(out ? HW::GBA::Request::Disconnect : HW::GBA::Request::Connect,
+                              std::string{});
+}
+
+}  // namespace Libretro::GBALink
+
+#endif  // HAS_LIBMGBA
