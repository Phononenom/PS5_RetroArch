@@ -13,6 +13,9 @@
 #include "Core/Core.h"
 #include "Core/CoreTiming.h"
 #include "Core/HW/GBACore.h"
+#include "Common/Config/Config.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/HW/GBAExternalKeys.h"
 #include "Core/HW/GBAPad.h"
 #include "Core/HW/SI/SI.h"
 #include "Core/HW/SI/SI_DeviceGCController.h"
@@ -59,7 +62,8 @@ int CSIDevice_GBAEmu::RunBuffer(u8* buffer, int request_length)
 #endif
     m_last_cmd = static_cast<EBufferCommands>(buffer[0]);
     m_timestamp_sent = m_system.GetCoreTiming().GetTicks();
-    m_core->SendJoybusCommand(m_timestamp_sent, TransferInterval(), buffer, m_keys);
+    m_core->SendJoybusCommand(m_timestamp_sent, TransferInterval(), buffer,
+                              m_keys | HW::GBA::AllExternalKeys(m_device_number));
 
     auto& si = m_system.GetSerialInterface();
     si.RemoveEvent(m_device_number);
@@ -146,9 +150,64 @@ DataResponse CSIDevice_GBAEmu::GetData(u32& hi, u32& low)
     m_keys |= static_cast<u16>(static_cast<bool>((pad_status.button & buttons_map[i]))) << i;
 
   // Use X button as a reset signal for NetPlay/Movies
-  if (pad_status.button & PadButton::PAD_BUTTON_X)
+  // or a frontend's request (dolphin_gba_reset, GBAWeb.cpp), taken here on the CPU thread
+  if ((pad_status.button & PadButton::PAD_BUTTON_X) ||
+      HW::GBA::ResetRequest(m_device_number).exchange(false))
     m_core->Reset();
 
+  // A frontend's other requests (dolphin_gba_request), as Dolphin's GBA window does them.
+  for (;;)
+  {
+    std::pair<HW::GBA::Request, std::string> request;
+    {
+      auto& requests = HW::GBA::RequestsFor(m_device_number);
+      std::lock_guard lock(requests.lock);
+      if (requests.queue.empty())
+        break;
+      request = std::move(requests.queue.front());
+      requests.queue.pop_front();
+    }
+    const std::string& path = request.second;
+    switch (request.first)
+    {
+    case HW::GBA::Request::Connect:
+    case HW::GBA::Request::Disconnect:
+      m_core->SetForceDisconnect(request.first == HW::GBA::Request::Disconnect);
+      break;
+    case HW::GBA::Request::LoadRom:
+    case HW::GBA::Request::LoadRomSavesHere:
+    {
+      // GBAWidget's RestartCore: the game in, the GBA started again (as it was, if it can't).
+      const auto& info = Config::MAIN_GBA_ROM_PATHS[m_device_number];
+      m_core->Stop();
+      Config::SetCurrent(Config::MAIN_GBA_SAVES_IN_ROM_PATH,
+                         request.first == HW::GBA::Request::LoadRomSavesHere);
+      Config::SetCurrent(info, path);
+      if (!m_core->Start(m_system.GetCoreTiming().GetTicks()))
+      {
+        Config::SetCurrent(info, Config::GetBase(info));
+        m_core->Start(m_system.GetCoreTiming().GetTicks());
+      }
+      break;
+    }
+    case HW::GBA::Request::ImportState:
+      m_core->ImportState(path);
+      break;
+    case HW::GBA::Request::ExportState:
+      m_core->ExportState(path);
+      break;
+    case HW::GBA::Request::ImportSave:
+      m_core->ImportSave(path);
+      break;
+    case HW::GBA::Request::ExportSave:
+      m_core->ExportSave(path);
+      break;
+    case HW::GBA::Request::EReaderCard:
+      m_core->EReaderQueueCard(path);
+      break;
+    }
+  }
+
   return DataResponse::NoData;
 }
 
