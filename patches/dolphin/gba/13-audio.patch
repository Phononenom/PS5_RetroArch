+// Each GBA's loudness: its Volume option (Volume held with up/down changes it for the session), and
+// Mute, toggled by its player's button.
+static void UpdateGBASound(const int* player_of, const bool* active,
+                           const bool (*inputs)[GBA_INPUT_COUNT],
+                           const bool (*was)[GBA_INPUT_COUNT])
+{
+  using namespace Libretro::Options;
+  static bool muted[4]{};
+  static int volume[4] = {100, 100, 100, 100};
+  static std::string last_volume[4];
+  static int frames[4]{};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU)
+    {
+      Libretro::GBASound::Route(port, -1);
+      continue;
