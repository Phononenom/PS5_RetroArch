diff --git a/Source/Core/DolphinLibretro/GBASound.cpp b/Source/Core/DolphinLibretro/GBASound.cpp
new file mode 100644
index 0000000..8f1f4a9
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBASound.cpp
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinLibretro/GBASound.h"
+
+#ifdef HAS_LIBMGBA
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <libretro.h>
+
+#include "AudioCommon/Mixer.h"
+#include "AudioCommon/SoundStream.h"
+#include "Common/Logging/Log.h"
+#include "Core/System.h"
+
+namespace Libretro
+{
+extern retro_environment_t environ_cb;
+}
+
+namespace Libretro::GBASound
+{
+namespace
+{
+// This port's RetroArch: src/pad_speaker_ps5.h (the same layout, version 1).
+constexpr unsigned ENV_GET_PAD_SPEAKER = 0x20000 | 3;
+constexpr unsigned SPEAKER_RATE = 48000;
+struct PadSpeaker
+{
+  unsigned version;
+  bool (*open)(unsigned port);
+  size_t (*write)(unsigned port, const int16_t* samples, size_t count);
+  void (*close)(unsigned port);
+};
+
+struct State
+{
+  std::mutex lock;  // all below but the atomics
+  const PadSpeaker* speaker = nullptr;
+  bool asked = false;  // the environment call was made
+  std::array<std::atomic<int>, 4> player{-1, -1, -1, -1};  // whose speaker each GBA plays on
+  std::array<int, 4> wanted{-1, -1, -1, -1};
+  // The mixer each request was applied to: none yet (early in a game) or a new game's is a new
+  // request, so a speaker asked for from the start is not left on the TV.
+  std::array<Mixer*, 4> applied_to{};
+  std::array<bool, 4> open{};          // speakers (by RetroArch port) opened here
+  std::array<bool, 4> failed{};        // speakers that would not open (not asked again)
+  std::array<std::atomic<bool>, 4> restart{};
+  std::array<std::atomic<bool>, 4> smooth{true, true, true, true};  // the feeder starts that GBA's resampler over
+  std::thread thread;
+  std::atomic<bool> stop{false};
+};
+
+State& S()
+{
+  static State* state = new State;  // never destroyed: the thread may outlive static destructors
+  return *state;
+}
+
+Mixer* GetMixer()
+{
+  SoundStream* stream = Core::System::GetInstance().GetSoundStream();
+  return stream ? stream->GetMixer() : nullptr;
+}
+
+// Every 10 ms: each GBA that plays on a speaker gives 10 ms of its sound, at the mixer's rate,
+// made 48 kHz mono (between two samples, as far along as the speaker's is).
+void Feed()
+{
+  State& s = S();
+  std::vector<s16> stereo;
+  std::vector<int> source;
+  std::vector<int16_t> mono(SPEAKER_RATE / 100);
+  // Each GBA's resampler: how far past its last kept sample the speaker's next one is, and that
+  // sample (the feeder's own).
+  double position[4] = {};
+  int last[4] = {};
+  bool told_full[4] = {};  // a full speaker queue is said once per routing
+  auto next = std::chrono::steady_clock::now();
+  while (!s.stop.load(std::memory_order_relaxed))
+  {
+    next += std::chrono::milliseconds(10);
+    std::this_thread::sleep_until(next);
+    Mixer* mixer = GetMixer();
+    const PadSpeaker* speaker = s.speaker;
+    if (!mixer || !speaker)
+      continue;
+    const unsigned in_rate = mixer->GetSampleRate();
+    if (in_rate < 8000)
+      continue;
+    for (int port = 0; port < 4; ++port)
+    {
+      const int player = s.player[port].load(std::memory_order_relaxed);
+      if (player < 0)
+        continue;
+      if (s.restart[port].exchange(false))
+      {
+        position[port] = 0;
+        last[port] = 0;
+        told_full[port] = false;
+      }
+      // Exactly the input frames 10 ms of output covers (the fraction carries over), after the
+      // last one kept, so the GBA's sound is used up at the rate it comes.
+      const double step = static_cast<double>(in_rate) / SPEAKER_RATE;
+      const double end = position[port] + step * mono.size();
+      const std::size_t take = std::max<std::size_t>(1, static_cast<std::size_t>(end));
+      stereo.resize(take * 2);
+      mixer->MixGBA(port, stereo.data(), take);
+      source.resize(take + 1);
+      source[0] = last[port];
+      for (std::size_t k = 0; k < take; ++k)
+        source[k + 1] = (static_cast<int>(stereo[k * 2]) + stereo[k * 2 + 1]) / 2;
+      const bool smooth = s.smooth[port].load(std::memory_order_relaxed);
+      for (std::size_t i = 0; i < mono.size(); ++i)
+      {
+        const double p = position[port] + step * i;
+        const std::size_t at = std::min(take - 1, static_cast<std::size_t>(p));
+        // Simple: the nearer of the two; smooth: between them.
+        double f = std::min(1.0, p - static_cast<double>(at));
+        if (!smooth)
+          f = f < 0.5 ? 0.0 : 1.0;
+        mono[i] = static_cast<int16_t>(std::lround(source[at] * (1.0 - f) + source[at + 1] * f));
+      }
+      position[port] = std::max(0.0, end - static_cast<double>(take));
+      last[port] = source[take];
+      const std::size_t taken = speaker->write(static_cast<unsigned>(player), mono.data(), mono.size());
+      if (taken < mono.size() && !told_full[port])
+      {
+        told_full[port] = true;
+        WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: player {}'s controller speaker is behind, sound dropped",
+                     port + 1, player + 1);
+      }
+    }
+  }
+}
+}  // namespace
+
+void Route(int port, int player)
+{
+  State& s = S();
+  port &= 3;
+  std::lock_guard lock(s.lock);
+  Mixer* mixer = GetMixer();
+  if (player == s.wanted[port] && mixer == s.applied_to[port])
+    return;
+  s.wanted[port] = player;
+  s.applied_to[port] = mixer;
+  if (!s.asked)
+  {
+    s.asked = true;
+    const void* table = nullptr;
+    if (environ_cb && environ_cb(ENV_GET_PAD_SPEAKER, &table) && table &&
+        static_cast<const PadSpeaker*>(table)->version >= 1)
+      s.speaker = static_cast<const PadSpeaker*>(table);
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA: controller speakers {}",
+                 s.speaker ? "available" : "not offered by this RetroArch");
+  }
+  int using_player = -1;
+  if (player >= 0 && player < 4 && s.speaker && mixer)
+  {
+    if (!s.open[player] && !s.failed[player])
+    {
+      s.open[player] = s.speaker->open(static_cast<unsigned>(player));
+      s.failed[player] = !s.open[player];
+      if (s.failed[player])
+        WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: player {}'s controller speaker did not open",
+                     port + 1, player + 1);
+    }
+    if (s.open[player])
+      using_player = player;
+  }
+  s.restart[port].store(true);
+  s.player[port].store(using_player);
+  if (mixer)
+    mixer->SetGBARouted(port, using_player >= 0);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: sound on {}", port + 1,
+               using_player >= 0 ? "player " + std::to_string(using_player + 1) + "'s controller" :
+                                   std::string("the TV"));
+  if (using_player >= 0 && !s.thread.joinable())
+  {
+    s.stop.store(false);
+    s.thread = std::thread(Feed);
+  }
+}
+
+void SetSmooth(int port, bool smooth)
+{
+  S().smooth[port & 3].store(smooth, std::memory_order_relaxed);
+}
+
+void Shutdown()
+{
+  State& s = S();
+  std::lock_guard lock(s.lock);
+  if (s.thread.joinable())
+  {
+    s.stop.store(true);
+    s.thread.join();
+  }
+  Mixer* mixer = GetMixer();
+  for (int port = 0; port < 4; ++port)
+  {
+    s.player[port].store(-1);
+    s.wanted[port] = -1;
+    s.applied_to[port] = nullptr;
+    if (mixer)
+      mixer->SetGBARouted(port, false);
+  }
+  for (int player = 0; player < 4; ++player)
+  {
+    if (s.open[player] && s.speaker)
+      s.speaker->close(static_cast<unsigned>(player));
+    s.open[player] = false;
+    s.failed[player] = false;
+  }
+}
+}  // namespace Libretro::GBASound
+
+#else
+
+namespace Libretro::GBASound
+{
+void Route(int, int)
+{
+}
+void SetSmooth(int, bool)
+{
+}
+void Shutdown()
+{
+}
+}  // namespace Libretro::GBASound
+
+#endif  // HAS_LIBMGBA
