@@ -142,7 +143,8 @@ enum GBAInput
 {
   GBA_A, GBA_B, GBA_SELECT, GBA_START, GBA_RIGHT, GBA_LEFT, GBA_UP, GBA_DOWN, GBA_R, GBA_L,
   GBA_KEY_COUNT,  // the GBA's own keys, mGBA's bit order
-  GBA_INPUT_COUNT = GBA_KEY_COUNT
+  GBA_SHOW = GBA_KEY_COUNT,
