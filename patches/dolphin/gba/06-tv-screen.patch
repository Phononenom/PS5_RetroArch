diff --git a/Source/Core/DolphinLibretro/GBAScreen.cpp b/Source/Core/DolphinLibretro/GBAScreen.cpp
new file mode 100644
index 0000000..4fb8dbf
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBAScreen.cpp
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinLibretro/GBAScreen.h"
+
+#ifdef HAS_LIBMGBA
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include <imgui.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/TextureConfig.h"
+
+// VideoCommon/OnScreenUI.cpp: drawn under Dolphin's messages, inside its ImGui frame.
+namespace VideoCommon
+{
+extern void (*g_onscreen_ui_frontend_draw)(float width, float height);
+extern void (*g_onscreen_ui_frontend_forget)();
+}  // namespace VideoCommon
+
+// GBAWeb.cpp: a GBA's newest picture, 15-bit colour (red bits 0-4, green 5-9, blue 10-14).
+extern "C" bool dolphin_gba_get_frame(unsigned port, uint16_t* pixels, size_t capacity,
+                                      unsigned* width, unsigned* height, unsigned* seq);
+
+namespace Libretro::GBAScreen
+{
+namespace
+{
+constexpr unsigned MAX_W = 240, MAX_H = 160;
+
+struct Picture
+{
+  std::unique_ptr<AbstractTexture> texture;
+  AbstractGfx* made_by = nullptr;  // the backend it belongs to (a new one: start over)
+  unsigned width = 0, height = 0, seq = 0;
+  std::vector<u32> rgba;
+  std::vector<u16> raw;
+};
+
+std::array<Window, 4> s_windows;
+std::array<Picture, 4> s_pictures;
+
+
+u32 ToRGBA(u16 c)
+{
+  const u32 r = (c & 31) * 255 / 31, g = (c >> 5 & 31) * 255 / 31, b = (c >> 10 & 31) * 255 / 31;
+  return r | g << 8 | b << 16 | 0xFF000000u;
+}
+
+void Forget(Picture& picture)
+{
+  // A texture of a backend that is gone cannot be destroyed safely: let it go. (The on-screen
+  // layer's end calls Shutdown while it is still there, so this is only a safety net.)
+  if (picture.texture && (!g_gfx || picture.made_by != g_gfx.get()))
+    (void)picture.texture.release();
+  picture.texture.reset();
+  picture.made_by = nullptr;
+  picture.seq = 0;
+}
+
+// The newest picture of a port into its texture. False: nothing to draw yet.
+bool Update(int port, Picture& picture)
+{
+  if (picture.made_by != g_gfx.get())
+    Forget(picture);
+  picture.raw.resize(MAX_W * MAX_H);
+  unsigned width = 0, height = 0, seq = picture.seq;
+  if (dolphin_gba_get_frame(port, picture.raw.data(), picture.raw.size(), &width, &height, &seq))
+  {
+    if (!picture.texture || width != picture.width || height != picture.height)
+    {
+      const TextureConfig config(width, height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                 AbstractTextureType::Texture_2DArray);
+      picture.texture = g_gfx->CreateTexture(config, "GBA screen");
+      picture.made_by = g_gfx.get();
+      picture.width = width;
+      picture.height = height;
+      if (!picture.texture)
+      {
+        ERROR_LOG_FMT(SERIALINTERFACE, "GBA {}: no texture for its screen", port + 1);
+        return false;
+      }
+    }
+    picture.seq = seq;
+    const size_t n = size_t{width} * height;
+    picture.rgba.resize(n);
+    for (size_t i = 0; i < n; ++i)
+      picture.rgba[i] = ToRGBA(picture.raw[i]);
+    picture.texture->Load(0, width, height, width,
+                          reinterpret_cast<const u8*>(picture.rgba.data()), n * sizeof(u32));
+  }
+  return picture.texture != nullptr;
+}
+
+void Draw(float tv_width, float tv_height)
+{
+  ImDrawList* list = ImGui::GetBackgroundDrawList();
+  for (int port = 0; port < 4; ++port)
+  {
+    const Window& window = s_windows[port];
+    Picture& picture = s_pictures[port];
+    if (!window.shown.load(std::memory_order_relaxed))
+      continue;
+    if (!Update(port, picture))
+      continue;
+
+    // Two ninths of the TV's height, in the bottom right corner.
+    const float h = tv_height * 2.0f / 9.0f;
+    const float w = h * picture.width / std::max(1u, picture.height);
+    list->AddImage(static_cast<ImTextureID>(*picture.texture), ImVec2(tv_width - w, tv_height - h),
+                   ImVec2(tv_width, tv_height));
+  }
+}
+}  // namespace
+
+Window& Get(int port)
+{
+  return s_windows[port & 3];
+}
+
+void Install()
+{
+  VideoCommon::g_onscreen_ui_frontend_draw = Draw;
+  VideoCommon::g_onscreen_ui_frontend_forget = Shutdown;
+}
+
+void Shutdown()
+{
+  for (Picture& picture : s_pictures)
+    Forget(picture);
+}
+}  // namespace Libretro::GBAScreen
+
+#else
+
+namespace Libretro::GBAScreen
+{
+Window& Get(int port)
+{
+  static Window windows[4];
+  return windows[port & 3];
+}
+void Install()
+{
+}
+void Shutdown()
+{
+}
+}  // namespace Libretro::GBAScreen
+
+#endif  // HAS_LIBMGBA
diff --git a/Source/Core/DolphinLibretro/GBAScreen.h b/Source/Core/DolphinLibretro/GBAScreen.h
new file mode 100644
index 0000000..10b96cf
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBAScreen.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+namespace Libretro::GBAScreen
+{
+// Each GBA's screen over the game on the TV, drawn into Dolphin's own on-screen layer (ImGui,
+// VideoCommon/OnScreenUI.cpp) on the video thread. The frontend's thread (Input.cpp) says what
+// to show; the video thread reads it.
+struct Window
+{
+  std::atomic<bool> shown{false};
+};
+
+Window& Get(int port);
+
+// Puts the drawing in Dolphin's on-screen layer (once per process).
+void Install();
+
+// Before the video backend goes away (retro_unload_game): its textures go first.
+void Shutdown();
+}  // namespace Libretro::GBAScreen
