+void QuickState(int port, bool save)
+{
+  const std::string rom = Config::Get(Config::MAIN_GBA_ROM_PATHS[port & 3]);
+  if (rom.empty())
+  {
+    OSD::AddMessage(fmt::format("GBA {}: no game, no state", port + 1), OSD::Duration::SHORT);
+    return;
+  }
+  if (!save && HW::GBA::HardcoreActive().load(std::memory_order_relaxed))
+  {
+    WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: hardcore is on, no quick load", port + 1);
+    OSD::AddMessage("Hardcore mode: the GBA can't load states or saves", OSD::Duration::NORMAL);
+    return;
+  }
+  File::CreateFullPath(s_states_dir + DIR_SEP);
+  const std::string stem = std::filesystem::path(rom).stem().string();
+  // The nine slots: the first empty, else the oldest (save); the newest (load).
+  int pick = -1;
+  std::filesystem::file_time_type pick_time{};
+  for (int slot = 1; slot <= 9; ++slot)
+  {
+    const std::string path = fmt::format("{}/{}-p{}.ss{}", s_states_dir, stem, port + 1, slot);
+    std::error_code ec;
+    const auto time = std::filesystem::last_write_time(path, ec);
+    if (ec)
+    {
+      if (save)
+      {
+        pick = slot;
+        break;
+      }
+      continue;
+    }
+    if (pick < 0 || (save ? time < pick_time : time > pick_time))
+    {
+      pick = slot;
+      pick_time = time;
+    }
+  }
+  if (pick < 0)
+  {
+    OSD::AddMessage(fmt::format("GBA {}: no state to load", port + 1), OSD::Duration::SHORT);
+    return;
+  }
+  const std::string path = fmt::format("{}/{}-p{}.ss{}", s_states_dir, stem, port + 1, pick);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: quick {} slot {} ({})", port + 1, save ? "save" : "load",
+               pick, path);
+  OSD::AddMessage(fmt::format("GBA {}: {} slot {}", port + 1, save ? "saved to" : "loaded", pick),
+                  OSD::Duration::SHORT);
+  auto& requests = HW::GBA::RequestsFor(port);
+  std::lock_guard lock(requests.lock);
+  requests.queue.emplace_back(save ? HW::GBA::Request::ExportState : HW::GBA::Request::ImportState,
+                              path);
+}
+
+const std::string& StatesDir()
+{
+  return s_states_dir;
+}
 }  // namespace Libretro::GBALink
 
 #endif  // HAS_LIBMGBA
