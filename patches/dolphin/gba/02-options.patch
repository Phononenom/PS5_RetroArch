+// Shows the "GBA (Integrated)" core options only while a port is set to it. Said again every couple
+// of seconds as well as on a change: the options may be registered after the port is chosen, and
+// the frontend forgets visibility when they are.
+static void RefreshGBAOptions()
+{
+  bool present = false;
+  for (int i = 0; i < 4; ++i)
+    present |= input_types[i] == RETRO_DEVICE_GBA_EMU;
+  static int shown = -1;
+  static int quiet_frames = 0;
+  if (shown == (present ? 1 : 0) && ++quiet_frames < 120)
+    return;
+  if (shown != (present ? 1 : 0))
+    DEBUG_LOG_FMT(SERIALINTERFACE, "GBA: options {}", present ? "shown" : "hidden");
+  shown = present ? 1 : 0;
+  quiet_frames = 0;
+  Libretro::Options::SetGBAOptionsVisible(present);
+}
 
