+void SetGBAOptionsVisible(bool visible)
+{
+  if (!environ_cb)
+    return;
+  for (const retro_core_option_v2_definition* def = option_defs; def->key; ++def)
+  {
+    if (!def->category_key || strcmp(def->category_key, CATEGORY_GBA))
+      continue;
+    retro_core_option_display display{def->key, visible};
+    environ_cb(RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY, &display);
+  }
+}
