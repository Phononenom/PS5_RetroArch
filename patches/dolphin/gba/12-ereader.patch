diff --git a/Source/Core/DolphinLibretro/GBALink.cpp b/Source/Core/DolphinLibretro/GBALink.cpp
index ba25890..d3c9c90 100644
--- a/Source/Core/DolphinLibretro/GBALink.cpp
+++ b/Source/Core/DolphinLibretro/GBALink.cpp
@@ -51,6 +51,39 @@ std::string s_states_dir;
 std::array<std::vector<std::string>, 4> s_choices;
 // What each port was last given (game, and whether its save sits beside it).
 std::array<std::string, 4> s_applied;
+// The e-Reader cards in <Sys>/GBA/ereader (the options point into them), and each port's choice
+// as last seen.
+std::vector<std::string> s_cards;
+std::array<std::string, 4> s_card_seen;
+
+bool IsCard(const std::filesystem::path& path)
+{
+  return Common::CaseInsensitiveEquals(path.extension().string(), ".raw");
+}
+
+// Scans the port's chosen card into its GBA's e-Reader (on the CPU thread). False: none chosen.
+bool QueueCard(int port, const std::string& card)
+{
+  if (card.empty() || card == "none")
+    return false;
+  const std::string path = s_rom_root + DIR_SEP "ereader" DIR_SEP + card;
+  if (!File::Exists(path))
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA {}: e-Reader card {} not found", port + 1, path);
+    OSD::AddMessage(fmt::format("GBA {}: e-Reader card {} not found", port + 1, card),
+                    OSD::Duration::NORMAL, OSD::Color::RED);
+    return true;
+  }
+  {
+    auto& requests = HW::GBA::RequestsFor(port);
+    std::lock_guard lock(requests.lock);
+    requests.queue.emplace_back(HW::GBA::Request::EReaderCard, path);
+  }
+  OSD::AddMessage(fmt::format("GBA {}: e-Reader card {}", port + 1, card), OSD::Duration::SHORT);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: e-Reader card {}", port + 1, path);
+  return true;
+}
+
 bool IsRom(const std::filesystem::path& path)
 {
   return Common::CaseInsensitiveEquals(path.extension().string(), ".gba");
@@ -128,6 +161,36 @@ void PrepareOptions(const std::string& sys_dir, const char* save_dir)
     def->values[n] = {nullptr, nullptr};
   }
 
+  // The e-Reader cards, the same list for every port.
+  const std::string card_dir = s_rom_root + DIR_SEP "ereader";
+  File::CreateFullPath(card_dir + DIR_SEP);
+  s_cards.clear();
+  std::error_code ec;
+  for (const auto& entry : std::filesystem::directory_iterator(card_dir, ec))
+  {
+    if (entry.is_regular_file(ec) && IsCard(entry.path()))
+      s_cards.push_back(entry.path().filename().string());
+  }
+  std::sort(s_cards.begin(), s_cards.end());
+  if (s_cards.size() > MAX_ROMS)
+  {
+    WARN_LOG_FMT(SERIALINTERFACE, "GBA: {} e-Reader cards found, the first {} are listed",
+                 s_cards.size(), MAX_ROMS);
+    s_cards.resize(MAX_ROMS);
+  }
+  for (int port = 0; port < 4; ++port)
+  {
+    s_card_seen[port].clear();
+    retro_core_option_v2_definition* def = Options::FindDefinition(Options::gba::CARD[port]);
+    if (!def)
+      continue;
+    size_t n = 0;
+    def->values[n++] = {"none", "None"};
+    for (const std::string& card : s_cards)
+      def->values[n++] = {card.c_str(), card.c_str()};
+    def->values[n] = {nullptr, nullptr};
+  }
+
   const char* states = nullptr;
   if (environ_cb && environ_cb(ENV_GET_SAVESTATE_DIRECTORY, &states) && states && *states)
     s_states_dir = std::string(states) + DIR_SEP "GBA";
@@ -159,6 +222,15 @@ void ApplyRoms(const unsigned* input_types, unsigned gba_device)
       continue;
     const bool running = system.GetSerialInterface().GetDeviceType(port) ==
                          SerialInterface::SIDEVICE_GC_GBA_EMULATED;
+    // A card chosen while the GBA runs is scanned at once (the first look only notes it).
+    const std::string card = Options::GetCached<std::string>(Options::gba::CARD[port], "none");
+    if (card != s_card_seen[port])
+    {
+      const bool first = s_card_seen[port].empty();
+      s_card_seen[port] = card;
+      if (!first && running)
+        QueueCard(port, card);
+    }
     const std::string rom = WantedRom(port, gba_index++);
     const std::string key = rom + (here ? "\n1" : "\n0");
     if (key == s_applied[port])
@@ -266,6 +338,13 @@ void QuickState(int port, bool save)
                               path);
 }
 
+void ScanCard(int port)
+{
+  port &= 3;
+  if (!QueueCard(port, Options::GetCached<std::string>(Options::gba::CARD[port], "none")))
+    OSD::AddMessage(fmt::format("GBA {}: no e-Reader card chosen", port + 1), OSD::Duration::SHORT);
+}
+
 const std::string& StatesDir()
 {
   return s_states_dir;
