 #ifdef HAS_LIBMGBA
 
 namespace Libretro::GBALink
 {
+namespace
+{
+// A core option holds at most RETRO_NUM_CORE_OPTION_VALUES_MAX values, one of them the end mark.
+constexpr size_t MAX_ROMS = RETRO_NUM_CORE_OPTION_VALUES_MAX - 3;
+
+std::vector<std::string> s_subsystem_roms;
+std::string s_rom_root;     // <Sys>/GBA
+// The choices' strings (the options point into them); filled once, before registration.
+std::array<std::vector<std::string>, 4> s_choices;
+// The game each port was last given.
+std::array<std::string, 4> s_applied;
+bool IsRom(const std::filesystem::path& path)
+{
+  return Common::CaseInsensitiveEquals(path.extension().string(), ".gba");
+}
+
+// The ROMs directly in `dir`, as paths relative to <Sys>/GBA, sorted.
+std::vector<std::string> ListRoms(const std::string& dir, const std::string& prefix)
+{
+  std::vector<std::string> roms;
+  std::error_code ec;
+  for (const auto& entry : std::filesystem::directory_iterator(dir, ec))
+  {
+    if (entry.is_regular_file(ec) && IsRom(entry.path()))
+      roms.push_back(prefix + entry.path().filename().string());
+  }
+  std::sort(roms.begin(), roms.end());
+  return roms;
+}
+
+// The port's game as a full path ("" = none).
+std::string WantedRom(int port, int gba_index)
+{
+  const std::string choice =
+      Options::GetCached<std::string>(Options::gba::ROM[port], "auto");
+  if (choice == "none")
+    return {};
+  if (choice != "auto")
+    return s_rom_root + DIR_SEP + choice;
+  // Auto: the ROM picked with the disc for this GBA, else the first in <Sys>/GBA/portN.
+  if (gba_index >= 0 && gba_index < static_cast<int>(s_subsystem_roms.size()))
+    return s_subsystem_roms[gba_index];
+  const auto own = ListRoms(s_rom_root + DIR_SEP "port" + std::to_string(port + 1), "");
+  if (!own.empty())
+    return s_rom_root + DIR_SEP "port" + std::to_string(port + 1) + DIR_SEP + own.front();
+  return {};
+}
+}  // namespace
+
+void SetSubsystemRoms(std::vector<std::string> roms)
+{
+  s_subsystem_roms = std::move(roms);
+}
+
+void PrepareOptions(const std::string& sys_dir, const char* save_dir)
+{
+  s_rom_root = sys_dir + DIR_SEP "GBA";
+  for (int port = 0; port < 4; ++port)
+  {
+    const std::string sub = "port" + std::to_string(port + 1);
+    File::CreateFullPath(s_rom_root + DIR_SEP + sub + DIR_SEP);
+
+    std::vector<std::string>& choices = s_choices[port];
+    choices = ListRoms(s_rom_root + DIR_SEP + sub, sub + "/");
+    for (std::string& shared : ListRoms(s_rom_root, ""))
+      choices.push_back(std::move(shared));
+    if (choices.size() > MAX_ROMS)
+    {
+      WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: {} ROMs found, the first {} are listed", port + 1,
+                   choices.size(), MAX_ROMS);
+      choices.resize(MAX_ROMS);
+    }
+
+    retro_core_option_v2_definition* def = Options::FindDefinition(Options::gba::ROM[port]);
+    if (!def)
+      continue;
+    size_t n = 0;
+    def->values[n++] = {"auto", "Auto"};
+    def->values[n++] = {"none", "None"};
+    for (const std::string& choice : choices)
+    {
+      const size_t slash = choice.find('/');
+      def->values[n++] = {choice.c_str(),
+                          slash == std::string::npos ? choice.c_str() : choice.c_str() + slash + 1};
+    }
+    def->values[n] = {nullptr, nullptr};
+  }
+
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA: games in {}", s_rom_root);
+}
+
+void ApplyRoms(const unsigned* input_types, unsigned gba_device)
+{
+  auto& system = Core::System::GetInstance();
+  if (system.IsWii())
+    return;
+  int gba_index = 0;
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != gba_device)
+      continue;
+    const bool running = system.GetSerialInterface().GetDeviceType(port) ==
+                         SerialInterface::SIDEVICE_GC_GBA_EMULATED;
+    const std::string rom = WantedRom(port, gba_index++);
+    if (rom == s_applied[port])
+      continue;
+    s_applied[port] = rom;
+
+    const auto& info = Config::MAIN_GBA_ROM_PATHS[port];
+    if (!running || Config::Get(info) == rom)
+    {
+      // Read by the GBA when it starts (SI init, or Dolphin's UpdateDevices on the CPU thread).
+      Config::SetBaseOrCurrent(info, rom);
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: game {}", port + 1, rom.empty() ? "none" : rom);
+      continue;
+    }
+    // The GBA is running: put the game in on the CPU thread, as Dolphin's GBA window does.
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: changing game to {}", port + 1,
+                 rom.empty() ? "none" : rom);
+    OSD::AddMessage(fmt::format("GBA {}: {}", port + 1,
+                                rom.empty() ? std::string("no game") :
+                                              std::filesystem::path(rom).stem().string()),
+                    OSD::Duration::SHORT);
+    auto& requests = HW::GBA::RequestsFor(port);
+    std::lock_guard lock(requests.lock);
+    requests.queue.emplace_back(HW::GBA::Request::LoadRom, rom);
+  }
+}
