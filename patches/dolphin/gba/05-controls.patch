+// Every frame, after polling: each GBA's keys from whoever plays it (HW::GBA::PadKeys), its
+// and what DolphinInput hides.
+static void UpdateGBAInput()
+{
+  using namespace Libretro::Options;
+  RefreshGBAOptions();
+
+  // Who plays each GBA port: a player (0-3), and whether the modifier applies.
+  int player_of[4];
+  bool direct[4];
+  for (int port = 0; port < 4; ++port)
+  {
+    player_of[port] = -1;
+    direct[port] = false;
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU)
+      continue;
+    if (HW::GBA::FrontendOwnsInput().load(std::memory_order_relaxed))
+      continue;  // a frontend maps the GBAs' buttons itself (dolphin_gba_set_keys)
+    const std::string who = GetCached<std::string>(gba::CONTROL[port], "p1");
+    if (who == "own")
+    {
+      player_of[port] = port;
+      direct[port] = true;
+    }
+    else if (who.size() == 2 && who[0] == 'p' && who[1] >= '1' && who[1] <= '4')
+    {
+      player_of[port] = who[1] - '1';
+    }
+  }
+
+  static int said_player[4] = {-2, -2, -2, -2};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU || player_of[port] == said_player[port])
+      continue;
+    said_player[port] = player_of[port];
+    if (player_of[port] < 0)
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: played by nobody (the web page only)", port + 1);
+    else
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: played by player {}{}", port + 1, player_of[port] + 1,
+                   direct[port] ? "" : " with the modifier");
+  }
+
+  // Each player's state: playing a GBA now (modifier held, or always, or direct), and the GBA
+  // input their controller gives.
+  bool plays[4]{};
+  bool via_modifier[4]{};
+  bool active[4]{};
+  bool inputs[4][GBA_INPUT_COUNT]{};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (player_of[port] < 0)
+      continue;
+    plays[player_of[port]] = true;
+    if (!direct[port])
+      via_modifier[player_of[port]] = true;
+  }
+
+  static bool was[4][GBA_INPUT_COUNT]{};
+  for (int player = 0; player < 4; ++player)
+  {
+    u32 hidden = 0;
+    bool hide_stick = false;
+    bool hide_all = false;
+    if (plays[player] && input_cb)
+    {
+      const std::string modifier_name = GetCached<std::string>(gba::MODIFIER[player], "l3");
+      const bool always = modifier_name == "always";
+      const int modifier = always ? -1 : RetroPadId(modifier_name);
+      bool held = always;
+      if (via_modifier[player] && modifier >= 0)
+      {
+        hidden |= 1u << modifier;  // the modifier never reaches the GameCube pad
+        held = input_cb(player, RETRO_DEVICE_JOYPAD, 0, modifier) != 0;
+      }
+      // A player who only plays their own port directly needs no modifier.
+      active[player] = held || !via_modifier[player];
+      hide_all = always && via_modifier[player];
+
+      const bool stick = GetCached<bool>(gba::STICK[player], true);
+      for (int input = 0; input < GBA_INPUT_COUNT; ++input)
+      {
+        const int id = RetroPadId(GetCached<std::string>(gba::BUTTON[player][input], "none"));
+        if (id < 0 || id == modifier)
+          continue;
+        if (active[player])
+        {
+          if (via_modifier[player])
+            hidden |= 1u << id;
+          inputs[player][input] = input_cb(player, RETRO_DEVICE_JOYPAD, 0, id) != 0;
+        }
+      }
+      if (active[player] && stick)
+      {
+        hide_stick = via_modifier[player];
+        constexpr int16_t threshold = 0x4000;
+        const int16_t x = input_cb(player, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT,
+                                   RETRO_DEVICE_ID_ANALOG_X);
+        const int16_t y = input_cb(player, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT,
+                                   RETRO_DEVICE_ID_ANALOG_Y);
+        inputs[player][GBA_RIGHT] |= x > threshold;
+        inputs[player][GBA_LEFT] |= x < -threshold;
+        inputs[player][GBA_DOWN] |= y > threshold;
+        inputs[player][GBA_UP] |= y < -threshold;
+      }
+    }
+    s_gc_hidden[player].store(hidden, std::memory_order_relaxed);
+    s_gc_hide_stick[player].store(hide_stick, std::memory_order_relaxed);
+    s_gc_hide_all[player].store(hide_all, std::memory_order_relaxed);
+  }
+
+  for (int port = 0; port < 4; ++port)
+  {
+    u16 keys = 0;
+    const int player = player_of[port];
+    if (player >= 0 && active[player])
+    {
+      for (int key = 0; key < GBA_KEY_COUNT; ++key)
+      {
+        if (inputs[player][key])
+          keys |= 1 << key;
+      }
+    }
+    HW::GBA::PadKeys(port).store(keys, std::memory_order_relaxed);
+  }
+  for (int player = 0; player < 4; ++player)
+    std::copy(std::begin(inputs[player]), std::end(inputs[player]), std::begin(was[player]));
+}
