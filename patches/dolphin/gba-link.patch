diff --git a/Source/Core/Core/HW/GBAExternalKeys.h b/Source/Core/Core/HW/GBAExternalKeys.h
new file mode 100644
index 0000000..fd708ac
--- /dev/null
+++ b/Source/Core/Core/HW/GBAExternalKeys.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <utility>
+
+#include "Common/CommonTypes.h"
+
+namespace HW::GBA
+{
+// Buttons held on a GBA from outside the emulated controller, as mGBA's key mask: A, B, Select,
+// Start, Right, Left, Up, Down, R, L = bits 0..9. Three sources, all OR-ed into the keys the
+// integrated GBA is given (SI_DeviceGBAEmu.cpp): the browser page's (GBAWeb.cpp, released after
+// two seconds of silence), the core's own button combos (Input.cpp), and a frontend that maps the
+// GBA's buttons itself (dolphin_gba_set_keys, GBAWeb.cpp).
+inline std::atomic<u16>& ExternalKeys(int device_number)
+{
+  static std::atomic<u16> keys[4]{};
+  return keys[device_number & 3];
+}
+
+inline std::atomic<u16>& PadKeys(int device_number)
+{
+  static std::atomic<u16> keys[4]{};
+  return keys[device_number & 3];
+}
+
+inline std::atomic<u16>& FrontendKeys(int device_number)
+{
+  static std::atomic<u16> keys[4]{};
+  return keys[device_number & 3];
+}
+
+// A frontend asked for the GBA to start over (dolphin_gba_reset): SI_DeviceGBAEmu takes it on the
+// CPU thread, as it does Dolphin's own reset (the GBA pad's X), so the GameCube game goes on.
+inline std::atomic<bool>& ResetRequest(int device_number)
+{
+  static std::atomic<bool> requests[4]{};
+  return requests[device_number & 3];
+}
+
+// The link cable pulled out (Dolphin's Disconnect), as the controller's Link Cable button and the
+// page's Disconnect GBA left it: both toggle the same state.
+inline std::atomic<bool>& LinkPulled(int device_number)
+{
+  static std::atomic<bool> pulled[4]{};
+  return pulled[device_number & 3];
+}
+
+// RetroAchievements hardcore is on (the libretro core asks the frontend every frame): the GBAs
+// load no state and import no save, as RetroArch loads no state of its own (SI_DeviceGBAEmu.cpp).
+inline std::atomic<bool>& HardcoreActive()
+{
+  static std::atomic<bool> on{false};
+  return on;
+}
+
+// A frontend maps the GBAs' buttons itself (it has called dolphin_gba_set_keys): a port holding a
+// GBA no longer reads its own libretro controller as the GBA's buttons (Input.cpp).
+inline std::atomic<bool>& FrontendOwnsInput()
+{
+  static std::atomic<bool> owns{false};
+  return owns;
+}
+
+// What a frontend asks a GBA to do (dolphin_gba_request, GBAWeb.cpp), as Dolphin's own GBA window
+// does it: SI_DeviceGBAEmu takes them at the GBA's next poll, on the CPU thread (as Dolphin's
+// RunOnCPUThread would).
+enum class Request
+{
+  Connect,          // plugged back in (Dolphin's Disconnect, off)
+  Disconnect,       // pulled out (Disconnect, on)
+  LoadRom,          // path: the game to put in (empty: none); the GBA starts over
+  LoadRomSavesHere, // the same, its save kept beside it (Dolphin's "Save in the Same Directory")
+  ImportState,      // path: an mGBA save state
+  ExportState,
+  ImportSave,       // path: a .sav
+  ExportSave,
+  EReaderCard,      // path: an e-Reader card (.raw), scanned
+};
+
+struct Requests
+{
+  std::mutex lock;
+  std::deque<std::pair<Request, std::string>> queue;
+};
+
+inline Requests& RequestsFor(int device_number)
+{
+  static Requests requests[4];
+  return requests[device_number & 3];
+}
+
+inline u16 AllExternalKeys(int device_number)
+{
+  return ExternalKeys(device_number).load(std::memory_order_relaxed) |
+         PadKeys(device_number).load(std::memory_order_relaxed) |
+         FrontendKeys(device_number).load(std::memory_order_relaxed);
+}
+}  // namespace HW::GBA
