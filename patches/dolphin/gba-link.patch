@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+namespace Libretro::GBASound
+{
+// Each GBA's sound on its player's controller speaker instead of the TV, through this port's
+// RetroArch (patches/series, 0139: environment call 0x20000 | 3). A thread pulls the GBA's sound
+// out of Dolphin's mixer (Mixer::MixGBA), makes it 48 kHz mono and writes it to the speaker.
+
+// Every frame, from the frontend's thread: port (0-3) on `player`'s controller speaker (a
+// RetroArch port), or on the TV with player -1. A speaker that does not open leaves it on the TV.
+void Route(int port, int player);
+
+// Every frame: how port's sound is made 48 kHz for the speaker. Smooth: between the two nearest
+// samples (the default); else the nearest one (Porpoise's "Simple").
+void SetSmooth(int port, bool smooth);
+
+// The content goes (retro_unload_game): back to the TV, the thread stopped, the speakers closed.
+void Shutdown();
+}  // namespace Libretro::GBASound
