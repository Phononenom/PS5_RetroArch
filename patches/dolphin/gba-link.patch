+{
+// Port-private environment calls of this port's RetroArch (patches/series, 0138).
+constexpr unsigned ENV_GET_HARDCORE = 0x20000 | 1;
+constexpr unsigned ENV_GET_SAVESTATE_DIRECTORY = 0x20000 | 2;
+
+// A core option holds at most RETRO_NUM_CORE_OPTION_VALUES_MAX values, one of them the end mark.
+constexpr size_t MAX_ROMS = RETRO_NUM_CORE_OPTION_VALUES_MAX - 3;
+
+std::vector<std::string> s_subsystem_roms;
+std::string s_rom_root;     // <Sys>/GBA
+std::string s_states_dir;
+// The choices' strings (the options point into them); filled once, before registration.
+std::array<std::vector<std::string>, 4> s_choices;
+// What each port was last given (game, and whether its save sits beside it).
+std::array<std::string, 4> s_applied;
+// The e-Reader cards in <Sys>/GBA/ereader (the options point into them), and each port's choice
+// as last seen.
+std::vector<std::string> s_cards;
+std::array<std::string, 4> s_card_seen;
+
+bool IsCard(const std::filesystem::path& path)
+{
+  return Common::CaseInsensitiveEquals(path.extension().string(), ".raw");
+}
+
+// Scans the port's chosen card into its GBA's e-Reader (on the CPU thread). False: none chosen.
+bool QueueCard(int port, const std::string& card)
+{
+  if (card.empty() || card == "none")
+    return false;
+  const std::string path = s_rom_root + DIR_SEP "ereader" DIR_SEP + card;
+  if (!File::Exists(path))
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA {}: e-Reader card {} not found", port + 1, path);
+    OSD::AddMessage(fmt::format("GBA {}: e-Reader card {} not found", port + 1, card),
+                    OSD::Duration::NORMAL, OSD::Color::RED);
+    return true;
+  }
+  {
+    auto& requests = HW::GBA::RequestsFor(port);
+    std::lock_guard lock(requests.lock);
+    requests.queue.emplace_back(HW::GBA::Request::EReaderCard, path);
+  }
+  OSD::AddMessage(fmt::format("GBA {}: e-Reader card {}", port + 1, card), OSD::Duration::SHORT);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: e-Reader card {}", port + 1, path);
+  return true;
+}
+
+bool IsRom(const std::filesystem::path& path)
+{
+  return Common::CaseInsensitiveEquals(path.extension().string(), ".gba");
+}
+
+// The ROMs directly in `dir`, as paths relative to <Sys>/GBA, sorted.
+std::vector<std::string> ListRoms(const std::string& dir, const std::string& prefix)
+{
+  std::vector<std::string> roms;
+  std::error_code ec;
+  for (const auto& entry : std::filesystem::directory_iterator(dir, ec))
+  {
+    if (entry.is_regular_file(ec) && IsRom(entry.path()))
+      roms.push_back(prefix + entry.path().filename().string());
+  }
+  std::sort(roms.begin(), roms.end());
+  return roms;
+}
+
+// The port's game as a full path ("" = none).
+std::string WantedRom(int port, int gba_index)
+{
+  const std::string choice =
+      Options::GetCached<std::string>(Options::gba::ROM[port], "auto");
+  if (choice == "none")
+    return {};
+  if (choice != "auto")
+    return s_rom_root + DIR_SEP + choice;
+  // Auto: the ROM picked with the disc for this GBA, else the first in <Sys>/GBA/portN.
+  if (gba_index >= 0 && gba_index < static_cast<int>(s_subsystem_roms.size()))
+    return s_subsystem_roms[gba_index];
+  const auto own = ListRoms(s_rom_root + DIR_SEP "port" + std::to_string(port + 1), "");
+  if (!own.empty())
+    return s_rom_root + DIR_SEP "port" + std::to_string(port + 1) + DIR_SEP + own.front();
+  return {};
+}
+}  // namespace
+
+void SetSubsystemRoms(std::vector<std::string> roms)
+{
+  s_subsystem_roms = std::move(roms);
+}
+
+void PrepareOptions(const std::string& sys_dir, const char* save_dir)
+{
+  s_rom_root = sys_dir + DIR_SEP "GBA";
+  for (int port = 0; port < 4; ++port)
+  {
+    const std::string sub = "port" + std::to_string(port + 1);
+    File::CreateFullPath(s_rom_root + DIR_SEP + sub + DIR_SEP);
+
+    std::vector<std::string>& choices = s_choices[port];
+    choices = ListRoms(s_rom_root + DIR_SEP + sub, sub + "/");
+    for (std::string& shared : ListRoms(s_rom_root, ""))
+      choices.push_back(std::move(shared));
+    if (choices.size() > MAX_ROMS)
+    {
+      WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: {} ROMs found, the first {} are listed", port + 1,
+                   choices.size(), MAX_ROMS);
+      choices.resize(MAX_ROMS);
+    }
+
+    retro_core_option_v2_definition* def = Options::FindDefinition(Options::gba::ROM[port]);
+    if (!def)
+      continue;
+    size_t n = 0;
+    def->values[n++] = {"auto", "Auto"};
+    def->values[n++] = {"none", "None"};
+    for (const std::string& choice : choices)
+    {
+      const size_t slash = choice.find('/');
+      def->values[n++] = {choice.c_str(),
+                          slash == std::string::npos ? choice.c_str() : choice.c_str() + slash + 1};
+    }
+    def->values[n] = {nullptr, nullptr};
+  }
+
+  // The e-Reader cards, the same list for every port.
+  const std::string card_dir = s_rom_root + DIR_SEP "ereader";
+  File::CreateFullPath(card_dir + DIR_SEP);
+  s_cards.clear();
+  std::error_code ec;
+  for (const auto& entry : std::filesystem::directory_iterator(card_dir, ec))
+  {
+    if (entry.is_regular_file(ec) && IsCard(entry.path()))
+      s_cards.push_back(entry.path().filename().string());
+  }
+  std::sort(s_cards.begin(), s_cards.end());
+  if (s_cards.size() > MAX_ROMS)
+  {
+    WARN_LOG_FMT(SERIALINTERFACE, "GBA: {} e-Reader cards found, the first {} are listed",
+                 s_cards.size(), MAX_ROMS);
+    s_cards.resize(MAX_ROMS);
+  }
+  for (int port = 0; port < 4; ++port)
+  {
+    s_card_seen[port].clear();
+    retro_core_option_v2_definition* def = Options::FindDefinition(Options::gba::CARD[port]);
+    if (!def)
+      continue;
+    size_t n = 0;
+    def->values[n++] = {"none", "None"};
+    for (const std::string& card : s_cards)
+      def->values[n++] = {card.c_str(), card.c_str()};
+    def->values[n] = {nullptr, nullptr};
+  }
+
+  const char* states = nullptr;
+  if (environ_cb && environ_cb(ENV_GET_SAVESTATE_DIRECTORY, &states) && states && *states)
+    s_states_dir = std::string(states) + DIR_SEP "GBA";
+  else if (save_dir && *save_dir)
+    s_states_dir = std::string(save_dir) + DIR_SEP "User" DIR_SEP "GBA" DIR_SEP "States";
+  else
+    s_states_dir = sys_dir + DIR_SEP "GBA" DIR_SEP "States";
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA: games in {}, states in {}", s_rom_root, s_states_dir);
+}
+
+void ApplySaveLocation()
+{
+  const bool here = Options::GetCached<bool>(Options::gba::SAVES_IN_ROM_DIR, false);
+  Config::SetBaseOrCurrent(Config::MAIN_GBA_SAVES_IN_ROM_PATH, here);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA: saves {}", here ? "beside each ROM" :
+                                                   File::GetUserPath(D_GBASAVES_IDX).c_str());
+}
+
+void ApplyRoms(const unsigned* input_types, unsigned gba_device)
+{
+  auto& system = Core::System::GetInstance();
+  if (system.IsWii())
+    return;
+  const bool here = Options::GetCached<bool>(Options::gba::SAVES_IN_ROM_DIR, false);
+  int gba_index = 0;
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != gba_device)
+      continue;
+    const bool running = system.GetSerialInterface().GetDeviceType(port) ==
+                         SerialInterface::SIDEVICE_GC_GBA_EMULATED;
+    // A card chosen while the GBA runs is scanned at once (the first look only notes it).
+    const std::string card = Options::GetCached<std::string>(Options::gba::CARD[port], "none");
+    if (card != s_card_seen[port])
+    {
+      const bool first = s_card_seen[port].empty();
+      s_card_seen[port] = card;
+      if (!first && running)
+        QueueCard(port, card);
+    }
+    const std::string rom = WantedRom(port, gba_index++);
+    const std::string key = rom + (here ? "\n1" : "\n0");
+    if (key == s_applied[port])
+      continue;
+    s_applied[port] = key;
+
+    const auto& info = Config::MAIN_GBA_ROM_PATHS[port];
+    if (!running || Config::Get(info) == rom)
+    {
+      // Read by the GBA when it starts (SI init, or Dolphin's UpdateDevices on the CPU thread).
+      Config::SetBaseOrCurrent(info, rom);
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: game {}", port + 1, rom.empty() ? "none" : rom);
+      continue;
+    }
+    // The GBA is running: put the game in on the CPU thread, as Dolphin's GBA window does.
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: changing game to {}", port + 1,
+                 rom.empty() ? "none" : rom);
+    OSD::AddMessage(fmt::format("GBA {}: {}", port + 1,
+                                rom.empty() ? std::string("no game") :
+                                              std::filesystem::path(rom).stem().string()),
+                    OSD::Duration::SHORT);
+    auto& requests = HW::GBA::RequestsFor(port);
+    std::lock_guard lock(requests.lock);
+    requests.queue.emplace_back(
+        here ? HW::GBA::Request::LoadRomSavesHere : HW::GBA::Request::LoadRom, rom);
+  }
+}
+
+void PollHardcore()
+{
+  bool on = false;
+  if (!environ_cb || !environ_cb(ENV_GET_HARDCORE, &on))
+    on = false;
+  const bool was = HW::GBA::HardcoreActive().exchange(on, std::memory_order_relaxed);
+  if (on != was)
+    NOTICE_LOG_FMT(SERIALINTERFACE, "GBA: hardcore {}: state load and save import are {}",
+                   on ? "on" : "off", on ? "off" : "on");
+}
+
+void ToggleLinkCable(int port)
+{
+  const bool out = !HW::GBA::LinkPulled(port).load();
+  HW::GBA::LinkPulled(port).store(out);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: link cable {}", port + 1, out ? "out" : "in");
+  OSD::AddMessage(fmt::format("GBA {}: link cable {}", port + 1, out ? "out" : "in"),
+                  OSD::Duration::SHORT);
+  auto& requests = HW::GBA::RequestsFor(port);
+  std::lock_guard lock(requests.lock);
+  requests.queue.emplace_back(out ? HW::GBA::Request::Disconnect : HW::GBA::Request::Connect,
+                              std::string{});
+}
+
+void QuickState(int port, bool save)
+{
+  const std::string rom = Config::Get(Config::MAIN_GBA_ROM_PATHS[port & 3]);
+  if (rom.empty())
+  {
+    OSD::AddMessage(fmt::format("GBA {}: no game, no state", port + 1), OSD::Duration::SHORT);
+    return;
+  }
+  if (!save && HW::GBA::HardcoreActive().load(std::memory_order_relaxed))
+  {
+    WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: hardcore is on, no quick load", port + 1);
+    OSD::AddMessage("Hardcore mode: the GBA can't load states or saves", OSD::Duration::NORMAL);
+    return;
+  }
+  File::CreateFullPath(s_states_dir + DIR_SEP);
+  const std::string stem = std::filesystem::path(rom).stem().string();
+  // The nine slots: the first empty, else the oldest (save); the newest (load).
+  int pick = -1;
+  std::filesystem::file_time_type pick_time{};
+  for (int slot = 1; slot <= 9; ++slot)
+  {
+    const std::string path = fmt::format("{}/{}-p{}.ss{}", s_states_dir, stem, port + 1, slot);
+    std::error_code ec;
+    const auto time = std::filesystem::last_write_time(path, ec);
+    if (ec)
+    {
+      if (save)
+      {
+        pick = slot;
+        break;
+      }
+      continue;
+    }
+    if (pick < 0 || (save ? time < pick_time : time > pick_time))
+    {
+      pick = slot;
+      pick_time = time;
+    }
+  }
+  if (pick < 0)
+  {
+    OSD::AddMessage(fmt::format("GBA {}: no state to load", port + 1), OSD::Duration::SHORT);
+    return;
+  }
+  const std::string path = fmt::format("{}/{}-p{}.ss{}", s_states_dir, stem, port + 1, pick);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: quick {} slot {} ({})", port + 1, save ? "save" : "load",
+               pick, path);
+  OSD::AddMessage(fmt::format("GBA {}: {} slot {}", port + 1, save ? "saved to" : "loaded", pick),
+                  OSD::Duration::SHORT);
+  auto& requests = HW::GBA::RequestsFor(port);
+  std::lock_guard lock(requests.lock);
+  requests.queue.emplace_back(save ? HW::GBA::Request::ExportState : HW::GBA::Request::ImportState,
+                              path);
+}
+
+void SetVolume(int port, int percent, bool muted)
+{
+  static int applied[4] = {-1, -1, -1, -1};
+  static bool was_muted[4]{};
+  static int was_percent[4] = {-1, -1, -1, -1};
+  port &= 3;
+  percent = std::clamp(percent, 0, 100);
+  const int level = muted ? 0 : percent;
+  // A change (the Volume button, or the option): show the level, but not the first one.
+  if (percent != was_percent[port])
+  {
+    if (was_percent[port] >= 0 && !muted)
+      GBAScreen::ShowVolume(port, percent);
+    was_percent[port] = percent;
+  }
+  if (muted != was_muted[port])
+  {
+    was_muted[port] = muted;
+    OSD::AddMessage(fmt::format("GBA {}: {}", port + 1, muted ? "muted" : "sound on"),
+                    OSD::Duration::SHORT);
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: {}", port + 1, muted ? "muted" : "sound on");
+  }
+  // A new game has a new mixer, at full volume: say it again.
+  static const Mixer* applied_to = nullptr;
+  SoundStream* stream = Core::System::GetInstance().GetSoundStream();
+  if (!stream || !stream->GetMixer())
+    return;
+  if (stream->GetMixer() != applied_to)
+  {
+    applied_to = stream->GetMixer();
+    std::fill(std::begin(applied), std::end(applied), -1);
+  }
+  if (level == applied[port])
+    return;
+  applied[port] = level;
+  const u32 volume = static_cast<u32>(level * 256 / 100);
+  stream->GetMixer()->SetGBAVolume(port, volume, volume);
+}
+
+void ScanCard(int port)
+{
+  port &= 3;
+  if (!QueueCard(port, Options::GetCached<std::string>(Options::gba::CARD[port], "none")))
+    OSD::AddMessage(fmt::format("GBA {}: no e-Reader card chosen", port + 1), OSD::Duration::SHORT);
+}
+
+const std::string& StatesDir()
+{
+  return s_states_dir;
+}
+}  // namespace Libretro::GBALink
+
+#endif  // HAS_LIBMGBA
diff --git a/Source/Core/DolphinLibretro/GBALink.h b/Source/Core/DolphinLibretro/GBALink.h
new file mode 100644
index 0000000..d5014d1
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBALink.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace Libretro::GBALink
+{
+// Subsystems "GameCube + N GBAs" (Main.cpp): the disc, then N GBA ROMs chosen in RetroArch's file
+// browser. ROM k goes to the k-th port set to GBA (Integrated).
+inline constexpr unsigned SUBSYSTEM_FIRST = 0x102;  // one GBA
+inline constexpr unsigned SUBSYSTEM_LAST = 0x105;   // four
+
+// retro_load_game_special: the ROMs picked with the disc (empty: the plain disc was loaded).
+void SetSubsystemRoms(std::vector<std::string> roms);
+
+// retro_load_game, before the core options are registered: lists the ROMs in <Sys>/GBA and
+// <Sys>/GBA/port1..4 as the choices of each port's "Game" option, and asks RetroArch (patch 0138)
+// for its savestate folder.
+void PrepareOptions(const std::string& sys_dir, const char* save_dir);
+
+// retro_load_game, after Dolphin's config is up: Dolphin's "Save in the Same Directory as the ROM".
+void ApplySaveLocation();
+
+// Each port's game, as the options and the subsystem say. A port whose GBA already runs gets the
+// change as a request (taken on the CPU thread); otherwise only the configuration is set, which
+// the GBA reads when it is created. Called on a port change and every frame (cheap when nothing
+// changed).
+void ApplyRoms(const unsigned* input_types, unsigned gba_device);
+
+// Every frame, on the frontend's thread: asks RetroArch whether hardcore is on (patch 0138),
+// for the CPU thread (HW::GBA::HardcoreActive).
+void PollHardcore();
+
+// A GBA's Link Cable button: pulls the cable out, or plugs it back in (Dolphin's Disconnect).
+void ToggleLinkCable(int port);
+
+// Quick Save: the game's state into the first empty of its nine slots, else the oldest. Quick
+// Load: the newest. Slots are per game and port: <StatesDir>/<rom name>-p<port>.ss1..9. Load is
+// refused in hardcore.
+void QuickState(int port, bool save);
+
+// A GBA's Scan e-Reader Card button: its e-Reader Card option's card into the GBA's e-Reader
+// (<Sys>/GBA/ereader, on the CPU thread). Choosing a card in the option while the GBA runs scans
+// it too (ApplyRoms).
+void ScanCard(int port);
+
+// A GBA's loudness in the game's sound (Dolphin's mixer, as its GBA window's Volume and Mute):
+// percent 0-100, or silent while muted. Says so on screen when muting changes.
+void SetVolume(int port, int percent, bool muted);
+
+// Where the GBAs' save states go: RetroArch's savestate folder (patch 0138) + "/GBA", else the
+// save folder's User/GBA/States.
+const std::string& StatesDir();
+}  // namespace Libretro::GBALink
diff --git a/Source/Core/DolphinLibretro/GBAScreen.cpp b/Source/Core/DolphinLibretro/GBAScreen.cpp
new file mode 100644
index 0000000..1dc092b
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBAScreen.cpp
@@ -0,0 +1,258 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinLibretro/GBAScreen.h"
+
+#ifdef HAS_LIBMGBA
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cfloat>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <fmt/format.h>
+#include <imgui.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/RenderState.h"
+#include "VideoCommon/TextureConfig.h"
+
+// VideoCommon/OnScreenUI.cpp: drawn under Dolphin's messages, inside its ImGui frame.
+namespace VideoCommon
+{
+extern void (*g_onscreen_ui_frontend_draw)(float width, float height);
+extern void (*g_onscreen_ui_frontend_forget)();
+}  // namespace VideoCommon
+
+// GBAWeb.cpp: a GBA's newest picture, 15-bit colour (red bits 0-4, green 5-9, blue 10-14).
+extern "C" bool dolphin_gba_get_frame(unsigned port, uint16_t* pixels, size_t capacity,
+                                      unsigned* width, unsigned* height, unsigned* seq);
+
+namespace Libretro::GBAScreen
+{
+namespace
+{
+constexpr unsigned MAX_W = 240, MAX_H = 160;
+
+struct Picture
+{
+  std::unique_ptr<AbstractTexture> texture;
+  AbstractGfx* made_by = nullptr;  // the backend it belongs to (a new one: start over)
+  unsigned width = 0, height = 0, seq = 0;
+  std::vector<u32> rgba, previous;
+  std::vector<u16> raw;
+};
+
+std::array<Window, 4> s_windows;
+std::array<Picture, 4> s_pictures;
+
+// The volume bar: each port's level and until when it shows (steady clock, ms).
+constexpr long long VOLUME_SHOWN_MS = 1500;
+std::array<std::atomic<int>, 4> s_volume{};
+std::array<std::atomic<long long>, 4> s_volume_until{};
+
+long long NowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// Every GBA whose volume just changed, one row each, in the top right corner.
+void DrawVolumes(ImDrawList* list, float tv_width, float tv_height)
+{
+  const long long now = NowMs();
+  const float scale = tv_height / 720.0f;
+  const float row_h = 28.0f * scale, bar_w = 140.0f * scale, pad = 8.0f * scale;
+  const float font = ImGui::GetFontSize() * std::max(1.0f, scale);
+  float y = 16.0f * scale;
+  for (int port = 0; port < 4; ++port)
+  {
+    if (s_volume_until[port].load(std::memory_order_relaxed) <= now)
+      continue;
+    const int level = std::clamp(s_volume[port].load(std::memory_order_relaxed), 0, 100);
+    const std::string label = fmt::format("GBA {}  {:3}%", port + 1, level);
+    const float text_w = ImGui::GetFont()->CalcTextSizeA(font, FLT_MAX, 0, label.c_str()).x;
+    const float box_w = pad * 3 + text_w + bar_w;
+    const float x = tv_width - 16.0f * scale - box_w;
+    list->AddRectFilled(ImVec2(x, y), ImVec2(x + box_w, y + row_h), IM_COL32(0, 0, 0, 170),
+                        4.0f * scale);
+    list->AddText(ImGui::GetFont(), font, ImVec2(x + pad, y + (row_h - font) / 2),
+                  IM_COL32(255, 255, 255, 255), label.c_str());
+    const float bx = x + pad * 2 + text_w, by = y + row_h * 0.35f, bh = row_h * 0.3f;
+    list->AddRectFilled(ImVec2(bx, by), ImVec2(bx + bar_w, by + bh), IM_COL32(90, 90, 90, 255));
+    list->AddRectFilled(ImVec2(bx, by), ImVec2(bx + bar_w * level / 100.0f, by + bh),
+                        IM_COL32(255, 255, 255, 255));
+    y += row_h + pad;
+  }
+}
+
+u32 ToRGBA(u16 c)
+{
+  const u32 r = (c & 31) * 255 / 31, g = (c >> 5 & 31) * 255 / 31, b = (c >> 10 & 31) * 255 / 31;
+  return r | g << 8 | b << 16 | 0xFF000000u;
+}
+
+u32 Mix(u32 a, u32 b)
+{
+  // Per channel average, alpha kept.
+  return ((a & 0xFEFEFEu) >> 1) + ((b & 0xFEFEFEu) >> 1) + (a & b & 0x010101u) | 0xFF000000u;
+}
+
+void Forget(Picture& picture)
+{
+  // A texture of a backend that is gone cannot be destroyed safely: let it go. (The on-screen
+  // layer's end calls Shutdown while it is still there, so this is only a safety net.)
+  if (picture.texture && (!g_gfx || picture.made_by != g_gfx.get()))
+    (void)picture.texture.release();
+  picture.texture.reset();
+  picture.made_by = nullptr;
+  picture.seq = 0;
+  picture.previous.clear();
+}
+
+// The newest picture of a port into its texture. False: nothing to draw yet.
+bool Update(int port, Picture& picture, bool blend)
+{
+  if (picture.made_by != g_gfx.get())
+    Forget(picture);
+  picture.raw.resize(MAX_W * MAX_H);
+  unsigned width = 0, height = 0, seq = picture.seq;
+  if (dolphin_gba_get_frame(port, picture.raw.data(), picture.raw.size(), &width, &height, &seq))
+  {
+    if (!picture.texture || width != picture.width || height != picture.height)
+    {
+      const TextureConfig config(width, height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                 AbstractTextureType::Texture_2DArray);
+      picture.texture = g_gfx->CreateTexture(config, "GBA screen");
+      picture.made_by = g_gfx.get();
+      picture.width = width;
+      picture.height = height;
+      picture.previous.clear();
+      if (!picture.texture)
+      {
+        ERROR_LOG_FMT(SERIALINTERFACE, "GBA {}: no texture for its screen", port + 1);
+        return false;
+      }
+    }
+    picture.seq = seq;
+    const size_t n = size_t{width} * height;
+    picture.rgba.resize(n);
+    for (size_t i = 0; i < n; ++i)
+      picture.rgba[i] = ToRGBA(picture.raw[i]);
+    if (blend && picture.previous.size() == n)
+    {
+      std::vector<u32> shown(n);
+      for (size_t i = 0; i < n; ++i)
+        shown[i] = Mix(picture.rgba[i], picture.previous[i]);
+      picture.texture->Load(0, width, height, width, reinterpret_cast<const u8*>(shown.data()),
+                            n * sizeof(u32));
+    }
+    else
+    {
+      picture.texture->Load(0, width, height, width,
+                            reinterpret_cast<const u8*>(picture.rgba.data()), n * sizeof(u32));
+    }
+    picture.previous = picture.rgba;
+  }
+  return picture.texture != nullptr;
+}
+
+void SetLinear(const ImDrawList*, const ImDrawCmd*)
+{
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+}
+
+void SetPoint(const ImDrawList*, const ImDrawCmd*)
+{
+  g_gfx->SetSamplerState(0, RenderState::GetPointSamplerState());
+}
+
+void Draw(float tv_width, float tv_height)
+{
+  ImDrawList* list = ImGui::GetBackgroundDrawList();
+  for (int port = 0; port < 4; ++port)
+  {
+    const Window& window = s_windows[port];
+    Picture& picture = s_pictures[port];
+    if (!window.shown.load(std::memory_order_relaxed))
+    {
+      picture.previous.clear();
+      continue;
+    }
+    if (!Update(port, picture, window.blend.load(std::memory_order_relaxed)))
+      continue;
+
+    const float h = tv_height * 2.0f / 9.0f * std::clamp(window.size.load(), 1, 4);
+    const float w = h * picture.width / std::max(1u, picture.height);
+    float cx = tv_width * window.x.load(std::memory_order_relaxed) / 1000.0f;
+    float cy = tv_height * window.y.load(std::memory_order_relaxed) / 1000.0f;
+    cx = std::clamp(cx, w / 2, std::max(w / 2, tv_width - w / 2));
+    cy = std::clamp(cy, h / 2, std::max(h / 2, tv_height - h / 2));
+    const int alpha = std::clamp(window.opacity.load(), 40, 100) * 255 / 100;
+    const bool soft = window.soft.load(std::memory_order_relaxed);
+    if (soft)
+      list->AddCallback(SetLinear, nullptr);
+    list->AddImage(static_cast<ImTextureID>(*picture.texture), ImVec2(cx - w / 2, cy - h / 2),
+                   ImVec2(cx + w / 2, cy + h / 2), ImVec2(0, 0), ImVec2(1, 1),
+                   IM_COL32(255, 255, 255, alpha));
+    if (soft)
+      list->AddCallback(SetPoint, nullptr);
+  }
+  DrawVolumes(ImGui::GetForegroundDrawList(), tv_width, tv_height);
+}
+}  // namespace
+
+Window& Get(int port)
+{
+  return s_windows[port & 3];
+}
+
+void ShowVolume(int port, int percent)
+{
+  port &= 3;
+  s_volume[port].store(percent, std::memory_order_relaxed);
+  s_volume_until[port].store(NowMs() + VOLUME_SHOWN_MS, std::memory_order_relaxed);
+}
+
+void Install()
+{
+  VideoCommon::g_onscreen_ui_frontend_draw = Draw;
+  VideoCommon::g_onscreen_ui_frontend_forget = Shutdown;
+}
+
+void Shutdown()
+{
+  for (Picture& picture : s_pictures)
+    Forget(picture);
+}
+}  // namespace Libretro::GBAScreen
+
+#else
+
+namespace Libretro::GBAScreen
+{
+Window& Get(int port)
+{
+  static Window windows[4];
+  return windows[port & 3];
+}
+void ShowVolume(int, int)
+{
+}
+void Install()
+{
+}
+void Shutdown()
+{
+}
+}  // namespace Libretro::GBAScreen
+
+#endif  // HAS_LIBMGBA
diff --git a/Source/Core/DolphinLibretro/GBAScreen.h b/Source/Core/DolphinLibretro/GBAScreen.h
new file mode 100644
index 0000000..6e22918
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBAScreen.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+namespace Libretro::GBAScreen
+{
+// Each GBA's screen over the game on the TV, drawn into Dolphin's own on-screen layer (ImGui,
+// VideoCommon/OnScreenUI.cpp) on the video thread. The frontend's thread (Input.cpp) says what
+// to show; the video thread reads it.
+struct Window
+{
+  std::atomic<bool> shown{false};
+  std::atomic<int> x{0}, y{0};      // the screen's centre, in thousandths of the TV's width/height
+  std::atomic<int> opacity{100};    // percent, 40-100
+  std::atomic<int> size{1};         // 1-4: 1x is two ninths of the TV's height
+  std::atomic<bool> soft{false};    // smoothed pixels (else square)
+  std::atomic<bool> blend{false};   // each picture mixed with the one before
+};
+
+Window& Get(int port);
+
+// A GBA's volume changed (not mute): a small bar in the TV's top right corner for a moment.
+void ShowVolume(int port, int percent);
+
+// Puts the drawing in Dolphin's on-screen layer (once per process).
+void Install();
+
+// Before the video backend goes away (retro_unload_game): its textures go first.
+void Shutdown();
+}  // namespace Libretro::GBAScreen
diff --git a/Source/Core/DolphinLibretro/GBASound.cpp b/Source/Core/DolphinLibretro/GBASound.cpp
new file mode 100644
index 0000000..8f1f4a9
--- /dev/null
+++ b/Source/Core/DolphinLibretro/GBASound.cpp
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinLibretro/GBASound.h"
+
+#ifdef HAS_LIBMGBA
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <libretro.h>
+
+#include "AudioCommon/Mixer.h"
+#include "AudioCommon/SoundStream.h"
+#include "Common/Logging/Log.h"
+#include "Core/System.h"
+
+namespace Libretro
+{
+extern retro_environment_t environ_cb;
+}
+
+namespace Libretro::GBASound
+{
+namespace
+{
+// This port's RetroArch: src/pad_speaker_ps5.h (the same layout, version 1).
+constexpr unsigned ENV_GET_PAD_SPEAKER = 0x20000 | 3;
+constexpr unsigned SPEAKER_RATE = 48000;
+struct PadSpeaker
+{
+  unsigned version;
+  bool (*open)(unsigned port);
+  size_t (*write)(unsigned port, const int16_t* samples, size_t count);
+  void (*close)(unsigned port);
+};
+
+struct State
+{
+  std::mutex lock;  // all below but the atomics
+  const PadSpeaker* speaker = nullptr;
+  bool asked = false;  // the environment call was made
+  std::array<std::atomic<int>, 4> player{-1, -1, -1, -1};  // whose speaker each GBA plays on
+  std::array<int, 4> wanted{-1, -1, -1, -1};
+  // The mixer each request was applied to: none yet (early in a game) or a new game's is a new
+  // request, so a speaker asked for from the start is not left on the TV.
+  std::array<Mixer*, 4> applied_to{};
+  std::array<bool, 4> open{};          // speakers (by RetroArch port) opened here
+  std::array<bool, 4> failed{};        // speakers that would not open (not asked again)
+  std::array<std::atomic<bool>, 4> restart{};
+  std::array<std::atomic<bool>, 4> smooth{true, true, true, true};  // the feeder starts that GBA's resampler over
+  std::thread thread;
+  std::atomic<bool> stop{false};
+};
+
+State& S()
+{
+  static State* state = new State;  // never destroyed: the thread may outlive static destructors
+  return *state;
+}
+
+Mixer* GetMixer()
+{
+  SoundStream* stream = Core::System::GetInstance().GetSoundStream();
+  return stream ? stream->GetMixer() : nullptr;
+}
+
+// Every 10 ms: each GBA that plays on a speaker gives 10 ms of its sound, at the mixer's rate,
+// made 48 kHz mono (between two samples, as far along as the speaker's is).
+void Feed()
+{
+  State& s = S();
+  std::vector<s16> stereo;
+  std::vector<int> source;
+  std::vector<int16_t> mono(SPEAKER_RATE / 100);
+  // Each GBA's resampler: how far past its last kept sample the speaker's next one is, and that
+  // sample (the feeder's own).
+  double position[4] = {};
+  int last[4] = {};
+  bool told_full[4] = {};  // a full speaker queue is said once per routing
+  auto next = std::chrono::steady_clock::now();
+  while (!s.stop.load(std::memory_order_relaxed))
+  {
+    next += std::chrono::milliseconds(10);
+    std::this_thread::sleep_until(next);
+    Mixer* mixer = GetMixer();
+    const PadSpeaker* speaker = s.speaker;
+    if (!mixer || !speaker)
+      continue;
+    const unsigned in_rate = mixer->GetSampleRate();
+    if (in_rate < 8000)
+      continue;
+    for (int port = 0; port < 4; ++port)
+    {
+      const int player = s.player[port].load(std::memory_order_relaxed);
+      if (player < 0)
+        continue;
+      if (s.restart[port].exchange(false))
+      {
+        position[port] = 0;
+        last[port] = 0;
+        told_full[port] = false;
+      }
+      // Exactly the input frames 10 ms of output covers (the fraction carries over), after the
+      // last one kept, so the GBA's sound is used up at the rate it comes.
+      const double step = static_cast<double>(in_rate) / SPEAKER_RATE;
+      const double end = position[port] + step * mono.size();
+      const std::size_t take = std::max<std::size_t>(1, static_cast<std::size_t>(end));
+      stereo.resize(take * 2);
+      mixer->MixGBA(port, stereo.data(), take);
+      source.resize(take + 1);
+      source[0] = last[port];
+      for (std::size_t k = 0; k < take; ++k)
+        source[k + 1] = (static_cast<int>(stereo[k * 2]) + stereo[k * 2 + 1]) / 2;
+      const bool smooth = s.smooth[port].load(std::memory_order_relaxed);
+      for (std::size_t i = 0; i < mono.size(); ++i)
+      {
+        const double p = position[port] + step * i;
+        const std::size_t at = std::min(take - 1, static_cast<std::size_t>(p));
+        // Simple: the nearer of the two; smooth: between them.
+        double f = std::min(1.0, p - static_cast<double>(at));
+        if (!smooth)
+          f = f < 0.5 ? 0.0 : 1.0;
+        mono[i] = static_cast<int16_t>(std::lround(source[at] * (1.0 - f) + source[at + 1] * f));
+      }
+      position[port] = std::max(0.0, end - static_cast<double>(take));
+      last[port] = source[take];
+      const std::size_t taken = speaker->write(static_cast<unsigned>(player), mono.data(), mono.size());
+      if (taken < mono.size() && !told_full[port])
+      {
+        told_full[port] = true;
+        WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: player {}'s controller speaker is behind, sound dropped",
+                     port + 1, player + 1);
+      }
+    }
+  }
+}
+}  // namespace
+
+void Route(int port, int player)
+{
+  State& s = S();
+  port &= 3;
+  std::lock_guard lock(s.lock);
+  Mixer* mixer = GetMixer();
+  if (player == s.wanted[port] && mixer == s.applied_to[port])
+    return;
+  s.wanted[port] = player;
+  s.applied_to[port] = mixer;
+  if (!s.asked)
+  {
+    s.asked = true;
+    const void* table = nullptr;
+    if (environ_cb && environ_cb(ENV_GET_PAD_SPEAKER, &table) && table &&
+        static_cast<const PadSpeaker*>(table)->version >= 1)
+      s.speaker = static_cast<const PadSpeaker*>(table);
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA: controller speakers {}",
+                 s.speaker ? "available" : "not offered by this RetroArch");
+  }
+  int using_player = -1;
+  if (player >= 0 && player < 4 && s.speaker && mixer)
+  {
+    if (!s.open[player] && !s.failed[player])
+    {
+      s.open[player] = s.speaker->open(static_cast<unsigned>(player));
+      s.failed[player] = !s.open[player];
+      if (s.failed[player])
+        WARN_LOG_FMT(SERIALINTERFACE, "GBA {}: player {}'s controller speaker did not open",
+                     port + 1, player + 1);
+    }
+    if (s.open[player])
+      using_player = player;
+  }
+  s.restart[port].store(true);
+  s.player[port].store(using_player);
+  if (mixer)
+    mixer->SetGBARouted(port, using_player >= 0);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: sound on {}", port + 1,
+               using_player >= 0 ? "player " + std::to_string(using_player + 1) + "'s controller" :
+                                   std::string("the TV"));
+  if (using_player >= 0 && !s.thread.joinable())
+  {
+    s.stop.store(false);
+    s.thread = std::thread(Feed);
+  }
+}
+
+void SetSmooth(int port, bool smooth)
+{
+  S().smooth[port & 3].store(smooth, std::memory_order_relaxed);
+}
+
+void Shutdown()
+{
+  State& s = S();
+  std::lock_guard lock(s.lock);
+  if (s.thread.joinable())
+  {
+    s.stop.store(true);
+    s.thread.join();
+  }
+  Mixer* mixer = GetMixer();
+  for (int port = 0; port < 4; ++port)
+  {
+    s.player[port].store(-1);
+    s.wanted[port] = -1;
+    s.applied_to[port] = nullptr;
+    if (mixer)
+      mixer->SetGBARouted(port, false);
+  }
+  for (int player = 0; player < 4; ++player)
+  {
+    if (s.open[player] && s.speaker)
+      s.speaker->close(static_cast<unsigned>(player));
+    s.open[player] = false;
+    s.failed[player] = false;
+  }
+}
+}  // namespace Libretro::GBASound
+
+#else
+
+namespace Libretro::GBASound
+{
+void Route(int, int)
+{
+}
+void SetSmooth(int, bool)
+{
+}
+void Shutdown()
+{
+}
+}  // namespace Libretro::GBASound
+
+#endif  // HAS_LIBMGBA
diff --git a/Source/Core/DolphinLibretro/GBASound.h b/Source/Core/DolphinLibretro/GBASound.h
new file mode 100644
index 0000000..68ad377
