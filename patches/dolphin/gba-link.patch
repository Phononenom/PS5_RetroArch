+// Buttons held on a GBA from outside the emulated controller (the libretro port's browser
+// page), as mGBA's key mask: A, B, Select, Start, Right, Left, Up, Down, R, L = bits 0..9.
+// OR-ed into the keys the integrated GBA is given (SI_DeviceGBAEmu.cpp).
+inline std::atomic<u16>& ExternalKeys(int device_number)
+{
+  static std::atomic<u16> keys[4]{};
+  return keys[device_number & 3];
+}
+}  // namespace HW::GBA
