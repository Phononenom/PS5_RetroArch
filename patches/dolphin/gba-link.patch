+// Controls (descGBA) and remaps them as it does a controller's; that port's buttons are the GBA's
+// keys (Update), alongside the browser page's (GBAWeb.cpp).
+#define RETRO_DEVICE_GBA_EMU ((13 << 8) | RETRO_DEVICE_JOYPAD)
+
+// Makes a channel's configured SI device the real one, directly, as this port has always done for
+// controllers. A GBA device is the exception, whether it is being added or replaced: building or
+// tearing one down starts threads and schedules CoreTiming events, which must happen on the CPU
+// thread and, at content load, only once the SI is initialised (a saved remap applies before
+// that, and would crash). Dolphin's own UpdateDevices() does it from the configuration, once a
+// field on the CPU thread, and SI Init does it at boot.
+static void ApplySIDevice(int channel)
+{
+  auto& si = Core::System::GetInstance().GetSerialInterface();
+  const SerialInterface::SIDevices desired = Config::Get(Config::GetInfoForSIDevice(channel));
+  for (const SerialInterface::SIDevices type : {si.GetDeviceType(channel), desired})
+  {
+    if (type == SerialInterface::SIDEVICE_GC_GBA ||
+        type == SerialInterface::SIDEVICE_GC_GBA_EMULATED)
+      return;
+  }
+  si.ChangeDevice(desired, channel);
+}
+
 /// The same remote with the dongle taken off, so everything downstream stays
 /// written against the five original ids.
 static inline unsigned wiimote_base_device(unsigned device)
@@ -104,6 +135,372 @@ static retro_input_poll_t poll_cb = nullptr;
 static retro_input_state_t input_cb = nullptr;
 static struct retro_rumble_interface rumble{};
 static unsigned input_types[8];
+
+// ---- GBA (Integrated): the controllers' GBA buttons -----------------------------------------------
+// Each GBA port is played by a player (that controller, while its modifier is held or always), by
+// the port's own controller (the player of that number's layout, no modifier), or by nobody (the
+// browser page only). While a player plays a GBA, the buttons of their GBA layout and the modifier
+// never reach the GameCube pad, so nothing moves twice.
+enum GBAInput
+{
+  GBA_A, GBA_B, GBA_SELECT, GBA_START, GBA_RIGHT, GBA_LEFT, GBA_UP, GBA_DOWN, GBA_R, GBA_L,
+  GBA_KEY_COUNT,  // the GBA's own keys, mGBA's bit order
+  GBA_RESET = GBA_KEY_COUNT, GBA_LINK, GBA_QUICK_SAVE, GBA_QUICK_LOAD,
+  GBA_SHOW, GBA_MOVE, GBA_OPACITY, GBA_MUTE, GBA_VOLUME, GBA_SCAN,
+  GBA_INPUT_COUNT
+};
+static_assert(GBA_INPUT_COUNT == Libretro::Options::gba::BUTTON_COUNT);
+
+// What the GameCube pad of each RetroArch port is not shown, read by Dolphin's input thread.
+static std::atomic<u32> s_gc_hidden[4];         // RetroPad button ids, as bits
+static std::atomic<bool> s_gc_hide_stick[4];    // the left stick (it is the GBA's D-pad)
+static std::atomic<bool> s_gc_hide_all[4];      // the controller only plays the GBA
+
+// The port's buttons as the GameCube pad (and the rest of Dolphin) is shown them. Only the two
+// places that read the pad use this; the GBA reads input_cb itself.
+static int16_t DolphinInput(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+  if (port < 4)
+  {
+    if (s_gc_hide_all[port].load(std::memory_order_relaxed))
+      return 0;
+    if ((device == RETRO_DEVICE_JOYPAD ||
+         (device == RETRO_DEVICE_ANALOG && index == RETRO_DEVICE_INDEX_ANALOG_BUTTON)) &&
+        id < 32 && (s_gc_hidden[port].load(std::memory_order_relaxed) >> id & 1))
+      return 0;
+    if (device == RETRO_DEVICE_ANALOG && index == RETRO_DEVICE_INDEX_ANALOG_LEFT &&
+        s_gc_hide_stick[port].load(std::memory_order_relaxed))
+      return 0;
+  }
+  return input_cb(port, device, index, id);
+}
+
+static int RetroPadId(const std::string& name)
+{
+  static constexpr struct
+  {
+    const char* name;
+    int id;
+  } ids[] = {
+      {"a", RETRO_DEVICE_ID_JOYPAD_A},           {"b", RETRO_DEVICE_ID_JOYPAD_B},
+      {"x", RETRO_DEVICE_ID_JOYPAD_X},           {"y", RETRO_DEVICE_ID_JOYPAD_Y},
+      {"l", RETRO_DEVICE_ID_JOYPAD_L},           {"r", RETRO_DEVICE_ID_JOYPAD_R},
+      {"l2", RETRO_DEVICE_ID_JOYPAD_L2},         {"r2", RETRO_DEVICE_ID_JOYPAD_R2},
+      {"l3", RETRO_DEVICE_ID_JOYPAD_L3},         {"r3", RETRO_DEVICE_ID_JOYPAD_R3},
+      {"select", RETRO_DEVICE_ID_JOYPAD_SELECT}, {"start", RETRO_DEVICE_ID_JOYPAD_START},
+      {"up", RETRO_DEVICE_ID_JOYPAD_UP},         {"down", RETRO_DEVICE_ID_JOYPAD_DOWN},
+      {"left", RETRO_DEVICE_ID_JOYPAD_LEFT},     {"right", RETRO_DEVICE_ID_JOYPAD_RIGHT},
+  };
+  for (const auto& entry : ids)
+  {
+    if (name == entry.name)
+      return entry.id;
+  }
+  return -1;
+}
+
+// Shows the "GBA (Integrated)" core options only while a port is set to it. Said again every couple
+// of seconds as well as on a change: the options may be registered after the port is chosen, and
+// the frontend forgets visibility when they are.
+static void RefreshGBAOptions()
+{
+  bool present = false;
+  for (int i = 0; i < 4; ++i)
+    present |= input_types[i] == RETRO_DEVICE_GBA_EMU;
+  static int shown = -1;
+  static int quiet_frames = 0;
+  if (shown == (present ? 1 : 0) && ++quiet_frames < 120)
+    return;
+  if (shown != (present ? 1 : 0))
+    DEBUG_LOG_FMT(SERIALINTERFACE, "GBA: options {}", present ? "shown" : "hidden");
+  shown = present ? 1 : 0;
+  quiet_frames = 0;
+  Libretro::Options::SetGBAOptionsVisible(present);
+}
+
+// Each GBA's screen on the TV (GBAScreen.cpp): shown as its Screen option and its player's Show
+// Screen say, moved and faded while Move Screen / Adjust Opacity are held (for the session; the
+// options set where it starts), sized, filtered and blended as its options say.
+static void UpdateGBAScreens(const int* player_of, const bool* active,
+                             const bool (*inputs)[GBA_INPUT_COUNT],
+                             const bool (*was)[GBA_INPUT_COUNT])
+{
+  using namespace Libretro::Options;
+  static bool toggled[4]{};
+  static std::string last_position[4], last_opacity[4];
+  static int opacity_frames[4]{};
+  for (int port = 0; port < 4; ++port)
+  {
+    auto& window = Libretro::GBAScreen::Get(port);
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU)
+    {
+      window.shown.store(false, std::memory_order_relaxed);
+      toggled[port] = false;
+      continue;
+    }
+    const std::string position = GetCached<std::string>(gba::POSITION[port], "bottom_right");
+    if (position != last_position[port])
+    {
+      last_position[port] = position;
+      const bool left = position == "bottom_left" || position == "top_left";
+      const bool top = position == "top_left" || position == "top_right";
+      const bool centre = position == "center";
+      window.x.store(centre ? 500 : left ? 0 : 1000, std::memory_order_relaxed);
+      window.y.store(centre ? 500 : top ? 0 : 1000, std::memory_order_relaxed);
+    }
+    const std::string opacity = GetCached<std::string>(gba::OPACITY[port], "100");
+    if (opacity != last_opacity[port])
+    {
+      last_opacity[port] = opacity;
+      window.opacity.store(std::clamp(atoi(opacity.c_str()), 40, 100), std::memory_order_relaxed);
+    }
+    window.size.store(std::clamp(GetCached<int>(gba::SIZE[port], 1), 1, 4), std::memory_order_relaxed);
+    window.soft.store(GetCached<std::string>(gba::FILTER[port], "sharp") == "soft",
+                      std::memory_order_relaxed);
+    window.blend.store(GetCached<bool>(gba::BLEND[port], false), std::memory_order_relaxed);
+
+    const int player = player_of[port];
+    const bool playing = player >= 0 && active[player];
+    const std::string screen = GetCached<std::string>(gba::SCREEN[port], "button");
+    bool shown = screen == "on";
+    if (screen == "button" && player >= 0)
+    {
+      const bool press = playing && inputs[player][GBA_SHOW];
+      if (GetCached<std::string>(gba::SHOW_MODE[player], "hold") == "toggle")
+      {
+        if (press && !was[player][GBA_SHOW])
+          toggled[port] = !toggled[port];
+        shown = toggled[port];
+      }
+      else
+      {
+        shown = press;
+      }
+    }
+    window.shown.store(shown, std::memory_order_relaxed);
+    if (!playing)
+      continue;
+
+    const int dx = (inputs[player][GBA_RIGHT] ? 1 : 0) - (inputs[player][GBA_LEFT] ? 1 : 0);
+    const int dy = (inputs[player][GBA_DOWN] ? 1 : 0) - (inputs[player][GBA_UP] ? 1 : 0);
+    if (inputs[player][GBA_MOVE])
+    {
+      window.x.store(std::clamp(window.x.load(std::memory_order_relaxed) + dx * 8, 0, 1000),
+                     std::memory_order_relaxed);
+      window.y.store(std::clamp(window.y.load(std::memory_order_relaxed) + dy * 8, 0, 1000),
+                     std::memory_order_relaxed);
+    }
+    else if (inputs[player][GBA_OPACITY] && dy != 0)
+    {
+      // One percent every other frame: 40% to 100% in two seconds.
+      if (++opacity_frames[port] % 2 == 0)
+        window.opacity.store(std::clamp(window.opacity.load(std::memory_order_relaxed) - dy, 40, 100),
+                             std::memory_order_relaxed);
+    }
+  }
+}
+
+// Each GBA's loudness: its Volume option (Volume held with up/down changes it for the session), and
+// Mute, toggled by its player's button.
+static void UpdateGBASound(const int* player_of, const bool* active,
+                           const bool (*inputs)[GBA_INPUT_COUNT],
+                           const bool (*was)[GBA_INPUT_COUNT])
+{
+  using namespace Libretro::Options;
+  static bool muted[4]{};
+  static int volume[4] = {100, 100, 100, 100};
+  static std::string last_volume[4];
+  static int frames[4]{};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU)
+    {
+      Libretro::GBASound::Route(port, -1);
+      continue;
+    }
+    // On its player's controller speaker, or the TV.
+    const bool on_speaker = GetCached<std::string>(gba::SPEAKER[port], "tv") == "controller";
+    Libretro::GBASound::Route(port, on_speaker ? player_of[port] : -1);
+    Libretro::GBASound::SetSmooth(port,
+                                  GetCached<std::string>(gba::SMOOTH[port], "smooth") != "simple");
+    const std::string option = GetCached<std::string>(gba::VOLUME[port], "100");
+    if (option != last_volume[port])
+    {
+      last_volume[port] = option;
+      volume[port] = std::clamp(atoi(option.c_str()), 0, 100);
+    }
+    const int player = player_of[port];
+    if (player >= 0 && active[player])
+    {
+      if (inputs[player][GBA_MUTE] && !was[player][GBA_MUTE])
+        muted[port] = !muted[port];
+      const int dy = (inputs[player][GBA_DOWN] ? 1 : 0) - (inputs[player][GBA_UP] ? 1 : 0);
+      if (inputs[player][GBA_VOLUME] && dy != 0 && ++frames[port] % 2 == 0)
+        volume[port] = std::clamp(volume[port] - dy, 0, 100);
+    }
+#ifdef HAS_LIBMGBA
+    Libretro::GBALink::SetVolume(port, volume[port], muted[port]);
+#endif
+  }
+}
+
+// Every frame, after polling: each GBA's keys from whoever plays it (HW::GBA::PadKeys), its
+// actions (reset, link cable, quick save/load) on a press, and what DolphinInput hides.
+static void UpdateGBAInput()
+{
+  using namespace Libretro::Options;
+  RefreshGBAOptions();
+#ifdef HAS_LIBMGBA
+  Libretro::GBALink::PollHardcore();
+  Libretro::GBALink::ApplyRoms(input_types, RETRO_DEVICE_GBA_EMU);
+#endif
+
+  // Who plays each GBA port: a player (0-3), and whether the modifier applies.
+  int player_of[4];
+  bool direct[4];
+  for (int port = 0; port < 4; ++port)
+  {
+    player_of[port] = -1;
+    direct[port] = false;
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU)
+      continue;
+    if (HW::GBA::FrontendOwnsInput().load(std::memory_order_relaxed))
+      continue;  // a frontend maps the GBAs' buttons itself (dolphin_gba_set_keys)
+    const std::string who = GetCached<std::string>(gba::CONTROL[port], "p1");
+    if (who == "own")
+    {
+      player_of[port] = port;
+      direct[port] = true;
+    }
+    else if (who.size() == 2 && who[0] == 'p' && who[1] >= '1' && who[1] <= '4')
+    {
+      player_of[port] = who[1] - '1';
+    }
+  }
+
+  static int said_player[4] = {-2, -2, -2, -2};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (input_types[port] != RETRO_DEVICE_GBA_EMU || player_of[port] == said_player[port])
+      continue;
+    said_player[port] = player_of[port];
+    if (player_of[port] < 0)
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: played by nobody (the web page only)", port + 1);
+    else
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA {}: played by player {}{}", port + 1, player_of[port] + 1,
+                   direct[port] ? "" : " with the modifier");
+  }
+
+  // Each player's state: playing a GBA now (modifier held, or always, or direct), and the GBA
+  // input their controller gives.
+  bool plays[4]{};
+  bool via_modifier[4]{};
+  bool active[4]{};
+  bool inputs[4][GBA_INPUT_COUNT]{};
+  for (int port = 0; port < 4; ++port)
+  {
+    if (player_of[port] < 0)
+      continue;
+    plays[player_of[port]] = true;
+    if (!direct[port])
+      via_modifier[player_of[port]] = true;
+  }
+
+  static bool was[4][GBA_INPUT_COUNT]{};
+  for (int player = 0; player < 4; ++player)
+  {
+    u32 hidden = 0;
+    bool hide_stick = false;
+    bool hide_all = false;
+    if (plays[player] && input_cb)
+    {
+      const std::string modifier_name = GetCached<std::string>(gba::MODIFIER[player], "l3");
+      const bool always = modifier_name == "always";
+      const int modifier = always ? -1 : RetroPadId(modifier_name);
+      bool held = always;
+      if (via_modifier[player] && modifier >= 0)
+      {
+        hidden |= 1u << modifier;  // the modifier never reaches the GameCube pad
