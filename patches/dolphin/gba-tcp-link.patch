@@ -4,6 +4,7 @@
 #include "Core/HW/SI/SI_DeviceGBA.h"
 
 #include <cstddef>
+#include <cstdio>
 #include <cstring>
 #include <memory>
 #include <mutex>
@@ -47,11 +48,25 @@ static void GBAConnectionWaiter()
 
   // "dolphin gba"
   if (server.listen(0xd6ba) != sf::Socket::Status::Done)
+  {
+    // Silent before: the emulator then simply never connects.
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA (TCP): cannot listen on port {}", 0xd6ba);
+    std::fprintf(stderr, "dolphin GBA (TCP): cannot listen on port %d\n", 0xd6ba);
     return;
+  }
 
   // "clock"
   if (clock_server.listen(0xc10c) != sf::Socket::Status::Done)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA (TCP): cannot listen on port {}", 0xc10c);
+    std::fprintf(stderr, "dolphin GBA (TCP): cannot listen on port %d\n", 0xc10c);
     return;
+  }
+
+  NOTICE_LOG_FMT(SERIALINTERFACE, "GBA (TCP): listening on ports {} (data) and {} (clock)", 0xd6ba,
+                 0xc10c);
+  std::fprintf(stderr, "dolphin GBA (TCP): listening on ports %d (data) and %d (clock)\n", 0xd6ba,
+               0xc10c);
 
   server.setBlocking(false);
   clock_server.setBlocking(false);
